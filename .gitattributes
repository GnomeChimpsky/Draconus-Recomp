* text=auto

# Windows launchers keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Everything else is LF, including on Windows checkouts
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.patch text eol=lf
# A patch's blank context lines are a single space by design; don't flag the patch file itself.
*.patch -whitespace

# Bundled third-party binaries (third_party/renhdrum/renhdrum.dll): never normalised, never diffed.
*.dll binary
