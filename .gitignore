# Setup and generated output — never commit
work/
scratch/
.tmp/

# The engine is fetched by setup.ps1 at a pinned commit and is not part of this repository.
engine/

# Game data and anything derived from it. Dumps live in dumps/ by convention (docs/LEGAL.md);
# the extension list catches a dump kept anywhere else.
dumps/
*.gdi
*.chd
*.bin
*.raw
*.iso
*.cdi
game/*/extracted/

# Screenshots and captures (guest pixels)
capture-*
*.ppm
*.png
!tools/launcher-*.png
!Draconus Recomped Emblem light.png
*.vmu
*.sav
screenshot-*.ppm

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Build output
build*/
out/

# Editor / OS
.vs/
.vscode/
.DS_Store
Thumbs.db

# Local engine checkout (a pristine copy for source reading) and desktop shortcuts
dream-recomp-main/
*.lnk