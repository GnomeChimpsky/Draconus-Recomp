+    else if (t >= 130 && t < 160)
+        hat = SDL_HAT_RIGHT;
+    else if (t >= 160 && t < 190)
+        hat = SDL_HAT_UP;
+    else if (t >= 190 && t < 220)
+        hat = SDL_HAT_DOWN;
+    SDL_SetJoystickVirtualHat(j, 0, hat);
