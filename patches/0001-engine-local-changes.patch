+++ b/render/include/dream/render/present_rate.h
@@ -0,0 +1,17 @@
+// How often a finished picture is presented (--present-rate).
+//
+// The guest's clock is 60 Hz and presentation is meant to be decoupled from it: a 120 Hz display
+// should show each guest frame twice, a 144 Hz display 2.4 times on average. What the display can
+// actually show is the limit, though. Asking a 60 Hz panel for 120 presents makes every guest frame
+// wait two vblanks, which runs the game at half speed rather than smoothing it -- and the second
+// picture is never seen. This is the arithmetic, kept out of the boot so it can be tested.
+#pragma once
+
+namespace dream::render {
+
+// Presents per guest frame: requested / 60, capped to the display's refresh rate. `display_hz` 0
+// means the display could not be asked, in which case the request is left alone. 0 requested means
+// the default of one present per frame.
+double presents_per_frame(unsigned requested_hz, double display_hz);
+
+}  // namespace dream::render
