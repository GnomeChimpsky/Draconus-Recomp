+// DREAM_TRACE_FRAME_HIST=1: the distribution of frame times, not just the average. A 60 Hz target is
+// decided by the tail, not the mean: a scene that averages 8 ms still drops a frame every few
+// seconds if one frame in two hundred takes 20 ms. Each guest frame records the wall time between
+// two vertical blanks (the whole frame) and the time spent inside the vertical blank itself (render
+// and present), so a slow frame can be attributed to the guest's own work or to presentation.
+struct FrameTimes {
+    bool on = std::getenv("DREAM_TRACE_FRAME_HIST") != nullptr;
+    // DREAM_TRACE_FRAMES=<file>: every guest frame's interval and the time spent presenting it.
+    // The distribution is the point. Judder is a *pattern* -- intervals alternating between two
+    // values, or a regular beat against the panel -- and every summary statistic the report below
+    // prints averages exactly that away.
+    std::FILE* dump = nullptr;
+    FrameTimes() {
+        const char* path = std::getenv("DREAM_TRACE_FRAMES");
+        if (path && path[0] && (dump = std::fopen(path, "wb")))
+            std::fprintf(dump, "# frame interval_ms vblank_ms\n");
+    }
+    ~FrameTimes() {
+        if (dump)
+            std::fclose(dump);
+    }
+    FrameTimes(const FrameTimes&) = delete;
+    FrameTimes& operator=(const FrameTimes&) = delete;
+    FrameTimes(FrameTimes&&) = delete;
+    FrameTimes& operator=(FrameTimes&&) = delete;
+    std::vector<double> whole_ms, vblank_ms;
+    struct Slow {
+        std::uint64_t frame;
+        double whole, vblank;
+    };
+    std::vector<Slow> slow;  // every frame that missed the budget, for the worst-offender report
+    std::vector<Slow> slow_vblank;  // frames whose render/present was heavy, whatever the frame did
+    // A line every `window` frames, so a run can be read scene by scene instead of as one average
+    // over a title screen, a load and gameplay. The title screen is not the thing that drops frames.
+    std::uint64_t window = 600, window_frames = 0, window_start = 0;
+    double window_sum = 0.0, window_max = 0.0, window_vsum = 0.0, window_vmax = 0.0, window_over = 0.0;
+    double window_cpu_s = 0.0;  // process CPU at the previous flush, for the per-frame cost
+    std::chrono::steady_clock::time_point last{};
+    bool have_last = false;
+    void flush_window(std::uint64_t frame) {
+        if (window_frames == 0)
+            return;
+        const double n = static_cast<double>(window_frames);
+        const double cpu = process_cpu_seconds();
+        const double cpu_frame_ms =
+            window_cpu_s > 0.0 ? (cpu - window_cpu_s) * 1000.0 / n : 0.0;
+        window_cpu_s = cpu;
+        std::printf("frames %llu-%llu: %.2f ms mean, max %.2f, vblank %.2f mean / %.2f max, "
+                    "cpu %.2f ms, %.1f%% over budget\n",
+                    static_cast<unsigned long long>(window_start),
+                    static_cast<unsigned long long>(frame), window_sum / n, window_max,
+                    window_vsum / n, window_vmax, cpu_frame_ms, 100.0 * window_over / n);
+        window_frames = 0;
+        window_sum = window_max = window_vsum = window_vmax = window_over = 0.0;
+    }
+    void add(std::uint64_t frame, std::chrono::steady_clock::time_point vblank,
+             std::chrono::steady_clock::time_point vblank_end) {
+        if (!on && !dump)
+            return;
+        const double work = std::chrono::duration<double, std::milli>(vblank_end - vblank).count();
+        const double whole = have_last
+                                 ? std::chrono::duration<double, std::milli>(vblank - last).count()
+                                 : -1.0;
+        if (dump && whole >= 0.0)
+            std::fprintf(dump, "%llu %.4f %.4f\n", static_cast<unsigned long long>(frame), whole,
+                         work);
+        if (on) {
+            vblank_ms.push_back(work);
+            window_vsum += work;
+            window_vmax = std::max(window_vmax, work);
+            if (work > 3.0)
+                slow_vblank.push_back({frame, 0.0, work});
+            if (have_last) {
+                whole_ms.push_back(whole);
+                if (whole > 1000.0 / 60.0)
+                    slow.push_back({frame, whole, work});
+                if (window_frames == 0) {
+                    window_start = frame;
+                    if (window_cpu_s <= 0.0)
+                        window_cpu_s = process_cpu_seconds();
+                }
+                ++window_frames;
+                window_sum += whole;
+                window_max = std::max(window_max, whole);
+                if (whole > 1000.0 / 60.0)
+                    window_over += 1.0;
+                if (window_frames >= window)
+                    flush_window(frame);
+            }
+        }
+        last = vblank;
+        have_last = true;
+    }
+};
