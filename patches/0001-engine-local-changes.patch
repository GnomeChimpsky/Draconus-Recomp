+// Where this project writes files on the player's behalf: the platform's per-user data directory,
+// never the checkout. The input bindings follow the same rule (docs/future-enhancements.md): the
+// game's TOML is tracked, and a card changes every time the player saves.
+std::string host_data_dir() {
+#if defined(_WIN32)
+    const char* base = std::getenv("APPDATA");
+    if (base && *base)
+        return std::string(base) + "\\dream-recomp";
+#elif defined(__APPLE__)
+    const char* home = std::getenv("HOME");
+    if (home && *home)
+        return std::string(home) + "/Library/Application Support/dream-recomp";
+#else
+    const char* xdg = std::getenv("XDG_DATA_HOME");
+    if (xdg && *xdg)
+        return std::string(xdg) + "/dream-recomp";
+    const char* home = std::getenv("HOME");
+    if (home && *home)
+        return std::string(home) + "/.local/share/dream-recomp";
+#endif
+    return {};
+}
+
+// <data>/saves/<game id>/vmu_a1.bin, with the directories made. "a1" is the hardware address the
+// card answers on: port A, expansion slot 1. Empty when the platform's variables are unset or the
+// directories cannot be made, and the run then continues without a card rather than failing to
+// start over a convenience.
+std::string default_vmu_path(const std::string& game_id) {
+    if (game_id.empty())
+        return {};
+    const std::string root = host_data_dir();
+    if (root.empty())
+        return {};
+    const std::filesystem::path dir = std::filesystem::path(root) / "saves" / game_id;
+    std::error_code ec;
+    std::filesystem::create_directories(dir, ec);
+    if (ec)
+        return {};
+    return (dir / "vmu_a1.bin").string();
+}
