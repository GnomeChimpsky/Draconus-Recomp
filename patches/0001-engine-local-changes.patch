+#include "dream/render/window_size.h"
 #endif
 
 namespace {
@@ -63,6 +87,410 @@ struct StopRun {
     const char* why;
 };
 
+// DREAM_PROFILE=<interval ms>: where the host's own time goes, sampled. A thread suspends the
+// emulating thread on the interval, reads its instruction pointer and counts it; the report names
+// the hottest addresses, and the link map (built with /MAP) turns those into functions. This is the
+// measurement the interpreter's own study used (`sample`), made available on Windows where there is
+// no `sample`, and it costs a few per cent while it runs.
+//
+// It samples *host* addresses, not guest ones, on purpose: the guest's pc is only refreshed at
+// poll points, so a histogram of it silently attributes the runtime's own work -- memory resolve,
+// indirect dispatch, the audio chip -- to whatever guest instruction happened to be last named.
+struct HostSampler {
+#if defined(_WIN32)
+    struct Entry {
+        std::uintptr_t address;
+        std::uint32_t count;
+    };
+    static constexpr std::size_t kSlots = 1u << 18;
+
+    HANDLE thread = nullptr;
+    HANDLE main_thread = nullptr;
+    std::chrono::milliseconds interval{1};
+    std::vector<Entry> table;  // open addressing, written only by the sampler thread
+    std::unique_ptr<std::thread> sampler;
+    std::uintptr_t base = 0;
+    struct Module {
+        std::uintptr_t base;
+        std::uintptr_t size;
+        std::string name;
+    };
+    std::vector<Module> modules;
+    bool running = false;
+
+    void collect_modules() {
+        HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPMODULE, GetCurrentProcessId());
+        if (snap == INVALID_HANDLE_VALUE)
+            return;
+        MODULEENTRY32 me{};
+        me.dwSize = sizeof me;
+        if (Module32First(snap, &me)) {
+            do {
+                const std::string path = me.szExePath;
+                const std::size_t slash = path.find_last_of("\\/");
+                modules.push_back({reinterpret_cast<std::uintptr_t>(me.modBaseAddr), me.modBaseSize,
+                                   slash == std::string::npos ? path : path.substr(slash + 1)});
+            } while (Module32Next(snap, &me));
+        }
+        CloseHandle(snap);
+    }
+
+    // Which module an address is in, for the samples that are not in the launcher at all. Most of
+    // those are the graphics driver inside a present, and they are not this program's cost -- but
+    // they are wall time, so they have to be visible rather than silently dropped.
+    const char* module_of(std::uintptr_t address) const {
+        for (const Module& m : modules)
+            if (address >= m.base && address < m.base + m.size)
+                return m.name.c_str();
+        return nullptr;
+    }
+
+    void start(int ms) {
+        main_thread = GetCurrentThread();
+        if (!DuplicateHandle(GetCurrentProcess(), main_thread, GetCurrentProcess(), &thread, 0,
+                             FALSE, DUPLICATE_SAME_ACCESS))
+            return;
+        interval = std::chrono::milliseconds(std::max(1, ms));
+        table.assign(kSlots, Entry{0, 0});
+        base = reinterpret_cast<std::uintptr_t>(GetModuleHandleW(nullptr));
+        collect_modules();
+        timeBeginPeriod(1);
+        running = true;
+        sampler = std::make_unique<std::thread>([this] { loop(); });
+    }
+
+    void loop() {
+        while (running) {
+            std::this_thread::sleep_for(interval);
+            if (!running)
+                break;
+            if (SuspendThread(thread) == static_cast<DWORD>(-1))
+                continue;
+            CONTEXT ctx{};
+            ctx.ContextFlags = CONTEXT_CONTROL;
+            std::uintptr_t rip = 0;
+            if (GetThreadContext(thread, &ctx))
+                rip = static_cast<std::uintptr_t>(ctx.Rip);
+            ResumeThread(thread);
+            if (rip)
+                record(rip);
+        }
+    }
+
+    void record(std::uintptr_t address) {
+        const std::size_t mask = kSlots - 1;
+        std::size_t slot = (address >> 2) & mask;
+        for (std::size_t probes = 0; probes < 32; ++probes) {
+            Entry& e = table[slot];
+            if (e.address == address) {
+                ++e.count;
+                return;
+            }
+            if (e.address == 0) {
+                e.address = address;
+                e.count = 1;
+                return;
+            }
+            slot = (slot + 1) & mask;
+        }
+    }
+
+    void stop() {
+        if (!running)
+            return;
+        running = false;
+        if (sampler)
+            sampler->join();
+        sampler.reset();
+        timeEndPeriod(1);
+        if (thread) {
+            CloseHandle(thread);
+            thread = nullptr;
+        }
+    }
+
+    // Top addresses by sample count, as module-relative offsets, ready for the link map.
+    void report(std::uint64_t frames) const {
+        if (table.empty())
+            return;
+        std::vector<Entry> top;
+        std::uint64_t total = 0;
+        for (const Entry& e : table) {
+            if (e.address == 0)
+                continue;
+            total += e.count;
+            top.push_back(e);
+        }
+        if (total == 0)
+            return;
+        std::sort(top.begin(), top.end(), [](const Entry& a, const Entry& b) {
+            return a.count > b.count;
+        });
+        std::printf("profile: %llu samples over %llu frames (%.0f per frame), top addresses:\n",
+                    static_cast<unsigned long long>(total),
+                    static_cast<unsigned long long>(frames),
+                    frames ? static_cast<double>(total) / static_cast<double>(frames) : 0.0);
+        for (std::size_t i = 0; i < top.size() && i < 40; ++i) {
+            const std::uintptr_t address = top[i].address;
+            const double pct = 100.0 * static_cast<double>(top[i].count) / static_cast<double>(total);
+            const char* module = module_of(address);
+            if (module && std::strcmp(module, "draconus_boot.exe") != 0) {
+                // Another module: name it and its offset, because the map cannot. Waiting in the
+                // graphics driver is wall time but not this program's work, and the two have to be
+                // told apart; the module's own export table turns the offset into a function.
+                std::uintptr_t module_base = 0;
+                for (const Module& m : modules)
+                    if (address >= m.base && address < m.base + m.size)
+                        module_base = m.base;
+                std::printf("profile:   %-24s +%08llx %5.1f%%  %llu\n", module,
+                            static_cast<unsigned long long>(address - module_base), pct,
+                            static_cast<unsigned long long>(top[i].count));
+                continue;
+            }
+            const std::uintptr_t rva = address - base;
+            std::printf("profile:   rva %08llx  %5.1f%%  %llu\n",
+                        static_cast<unsigned long long>(rva), pct,
+                        static_cast<unsigned long long>(top[i].count));
+        }
+    }
+#else
+    void start(int) {}
+    void stop() {}
+    void report(std::uint64_t) const {}
+#endif
+};
