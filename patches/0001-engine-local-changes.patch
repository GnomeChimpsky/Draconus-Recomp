+// The budget a frame has to fit to hold 60 Hz. A frame that spends longer than this between two
+// vertical blanks cannot be displayed on time, whatever the average says.
+constexpr double kFrameBudgetMs = 1000.0 / 60.0;
+
+void report_frame_times(const FrameTimes& t) {
+    if (!t.on || t.whole_ms.empty())
+        return;
+    double sum = 0.0, worst = 0.0;
+    std::size_t over = 0, over20 = 0, over25 = 0, over33 = 0;
+    for (double ms : t.whole_ms) {
+        sum += ms;
+        worst = std::max(worst, ms);
+        if (ms > kFrameBudgetMs)
+            ++over;
+        if (ms > 20.0)
+            ++over20;
+        if (ms > 25.0)
+            ++over25;
+        if (ms > 33.0)
+            ++over33;
+    }
+    double vsum = 0.0, vworst = 0.0;
+    for (double ms : t.vblank_ms) {
+        vsum += ms;
+        vworst = std::max(vworst, ms);
+    }
+    const double n = static_cast<double>(t.whole_ms.size());
+    std::printf("frames: %.2f ms mean, p50 %.2f, p90 %.2f, p99 %.2f, max %.2f (%zu measured)\n",
+                sum / n, percentile(t.whole_ms, 0.50), percentile(t.whole_ms, 0.90),
+                percentile(t.whole_ms, 0.99), worst, t.whole_ms.size());
+    std::printf("frames: over 16.67 ms %zu (%.2f%%), over 20 ms %zu, over 25 ms %zu, over 33 ms %zu\n",
+                over, 100.0 * static_cast<double>(over) / n, over20, over25, over33);
+    if (!t.vblank_ms.empty()) {
+        const double vn = static_cast<double>(t.vblank_ms.size());
+        std::printf("frames: vblank cost %.2f ms mean, p99 %.2f, max %.2f\n", vsum / vn,
+                    percentile(t.vblank_ms, 0.99), vworst);
+    }
+    // Where the misses are. The guest frame number says which screen it was on; "vblank" is the
+    // render and present that frame did, so a large whole with a small vblank is the guest's own
+    // work (a scene change, a load) and a large vblank is the renderer (a texture, a pipeline).
+    if (!t.slow.empty()) {
+        std::printf("frames: %zu missed the budget, worst:\n", t.slow.size());
+        std::vector<FrameTimes::Slow> worst_list(t.slow);
+        std::sort(worst_list.begin(), worst_list.end(),
+                  [](const FrameTimes::Slow& a, const FrameTimes::Slow& b) {
+                      return a.whole > b.whole;
+                  });
+        for (std::size_t i = 0; i < worst_list.size() && i < 12; ++i)
+            std::printf("frames:   guest %llu: %.2f ms whole, %.2f ms in the vblank\n",
+                        static_cast<unsigned long long>(worst_list[i].frame), worst_list[i].whole,
+                        worst_list[i].vblank);
+    }
+    // The renderer's own tail: frames whose vblank (draw and present) took longer than 3 ms. A
+    // frame like this still fits the budget in a quiet scene, but it is one slow guest frame away
+    // from missing it, and it is where a texture or a pipeline is being built.
+    if (!t.slow_vblank.empty()) {
+        std::vector<FrameTimes::Slow> heavy(t.slow_vblank);
+        std::sort(heavy.begin(), heavy.end(),
+                  [](const FrameTimes::Slow& a, const FrameTimes::Slow& b) {
+                      return a.vblank > b.vblank;
+                  });
+        std::printf("frames: %zu vblanks over 3 ms, worst:\n", heavy.size());
+        for (std::size_t i = 0; i < heavy.size() && i < 12; ++i)
+            std::printf("frames:   guest %llu: %.2f ms in the vblank\n",
+                        static_cast<unsigned long long>(heavy[i].frame), heavy[i].vblank);
+    }
+#if defined(_WIN32)
+    // How much CPU the run actually used per frame, which is the number that decides whether 60 Hz
+    // is reachable: the interval between vertical blanks says how it felt, this says what it cost.
+    const double cpu = process_cpu_seconds();
+    const double frames = static_cast<double>(t.whole_ms.size());
+    if (frames > 0.0)
+        std::printf("frames: %.2f ms of CPU per frame, %.0f%% of one core at 60 Hz\n",
+                    cpu * 1000.0 / frames, 100.0 * cpu * 60.0 / frames);
+#endif
+}
