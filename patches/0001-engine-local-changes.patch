+TEST_CASE("the timer unit keeps the console's rate when the CPU is overclocked") {
+    // A frame is one vertical blank, so --sh4-clock buys more cycles per frame rather than a faster
+    // console: the timers have to keep ticking at the console's rate. A millisecond clock built on
+    // TMU0 (KallistiOS's is) that ran 1.5x fast would speed the whole game up while it still drew
+    // 60 frames a second, which is exactly what a naive overclock does.
+    auto ticks_left_after_one_second = [](std::uint64_t clock) {
+        sched::sh4_clock = clock;
+        sched::Scheduler s;
+        sh4::Intc intc;
+        sh4::Tmu tmu(s, intc);
+        tmu.write(sh4::Tmu::kBase + 0x08u, 0xFFFFFFFFu, 4);  // TCOR0: reload value
+        tmu.write(sh4::Tmu::kBase + 0x0Cu, 0xFFFFFFFFu, 4);  // TCNT0: counts down from here
+        tmu.write(sh4::Tmu::kBase + 0x04u, 1u, 4);           // TSTR: run channel 0
+        s.advance(clock);                                    // one second of real time
+        const std::uint32_t left = tmu.read(sh4::Tmu::kBase + 0x0Cu, 4);
+        sched::sh4_clock = sched::kSh4Clock;                 // leave the global as it was found
+        return left;
+    };
+    const std::uint32_t at_200 = ticks_left_after_one_second(200'000'000u);
+    const std::uint32_t at_300 = ticks_left_after_one_second(300'000'000u);
+    CHECK(at_200 == at_300);
+    // And it really did count: one second of one tick per sixteen cycles is 12.5 million ticks.
+    CHECK(at_200 == 0xFFFFFFFFu - 200'000'000u / 16u);
+}
