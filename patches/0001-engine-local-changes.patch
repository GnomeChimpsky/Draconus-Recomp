+                continue;
+            const std::size_t a = find(i), b = find(j);
+            if (a != b)
+                parent[b] = a;
+        }
+    }
+
+    // Each cluster's anchor comes from its union: the centre line for a centred element, the
+    // near edge for one at the side.
+    for (std::size_t i = 0; i < groups.size(); ++i) {
+        if (small(groups[i]) || wide(groups[i]) || find(i) != i)
+            continue;
+        float min_x = groups[i].min_x, max_x = groups[i].max_x;
+        for (std::size_t j = 0; j < groups.size(); ++j) {
+            if (find(j) != i)
+                continue;
+            min_x = std::min(min_x, groups[j].min_x);
+            max_x = std::max(max_x, groups[j].max_x);
+        }
+        if (max_x - min_x > width * 0.9f)
+            continue;
+        const float mid = 0.5f * (min_x + max_x);
+        float anchor = width * 0.5f;
+        if (mid < width / 3.0f)
+            anchor = min_x;
+        else if (mid > width * (2.0f / 3.0f))
+            anchor = max_x;
+        for (std::size_t j = 0; j < groups.size(); ++j) {
+            if (find(j) == i)
+                apply(anchor, groups[j]);
+        }
+    }
+    // A small glyph that found no larger element to attach to stays centred on the thing it
+    // labels (a damage number, a stand-alone counter).
+    for (std::size_t i = 0; i < groups.size(); ++i) {
+        if (small(groups[i]) && find(i) == i)
+            apply(0.5f * (groups[i].min_x + groups[i].max_x), groups[i]);
+    }
+    return adjusted;
+}
+
 }  // namespace dream::render
