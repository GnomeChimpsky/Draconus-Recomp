+    g_hash = (g_hash ^ (c.t ? 1u : 0u)) * 1099511628211ull;
+    if (g_hash_file && g_hash_interval && idx % g_hash_interval == 0)
+        std::fprintf(g_hash_file, "ck %llu %016llx %llu\n",
+                     static_cast<unsigned long long>(idx),
+                     static_cast<unsigned long long>(g_hash),
+                     static_cast<unsigned long long>(c.cycles));
+    if (idx < g_idx_from || idx > g_idx_to)
+        return;
+    if (c.cycles < g_from || c.cycles > g_to)
+        return;
+    // Every register, then the control state, so a divergence anywhere is caught at the instruction
+    // where it happens rather than at the next printed field.
+    std::fprintf(s.file, "%08x %llu", pc,
+                 static_cast<unsigned long long>(c.cycles));
+    for (int i = 0; i < 16; ++i) std::fprintf(s.file, " %08x", c.r[i]);
+    std::fprintf(s.file, " %u %08x %08x %08x %08x %08x %08x\n", c.t ? 1u : 0u, c.sr, c.spc, c.ssr,
+                 c.fpscr, c.pr, c.gbr);
+}
+
+void ssr_write(const char* tag, std::uint32_t pc, std::uint32_t value) noexcept {
+    static const bool on = std::getenv("DREAM_TRACE_SSR") != nullptr;
+    if (!on)
+        return;
+    std::fprintf(stderr, "ssr-write %-10s pc 0x%08x value 0x%08x\n", tag, pc, value);
+}
+
+void sr_write(const sh4::Ctx& c, std::uint32_t value) noexcept {
+    static const bool on = std::getenv("DREAM_TRACE_SR") != nullptr;
+    if (!on)
+        return;
+    std::fprintf(stderr, "sr-write pc 0x%08x value 0x%08x old 0x%08x\n", c.pc, value, c.sr);
+}
+
+void spc_write(const char* tag, std::uint32_t pc, std::uint32_t value) noexcept {
+    static const bool on = std::getenv("DREAM_TRACE_SPC") != nullptr;
+    if (!on)
+        return;
+    std::fprintf(stderr, "spc-write %-10s pc 0x%08x value 0x%08x\n", tag, pc, value);
+}
+
+}  // namespace dream::trace
