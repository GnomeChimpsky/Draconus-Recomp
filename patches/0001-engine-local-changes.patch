+// See dream/runtime/trace.h.
+#include "dream/runtime/trace.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include "dream/runtime/sh4/ctx.h"
+
+namespace dream::trace {
+
+namespace {
+
+std::uint64_t g_from = 0;  // DREAM_TRACE_FROM: ignore instructions before this guest cycle
+std::uint64_t g_to = ~0ull;
+std::uint64_t g_index = 0;        // instructions traced so far, identical in both engines
+std::uint64_t g_idx_from = 0, g_idx_to = ~0ull;
+std::uint64_t g_hash = 1469598103934665603ull;  // FNV-1a over (pc, r0-r15, sr, t)
+std::uint64_t g_hash_interval = 0;              // DREAM_TRACE_HASH: checkpoint every N
+FILE* g_hash_file = nullptr;  // DREAM_TRACE_TO: stop recording after this guest cycle
+
+struct Sink {
+    FILE* file = nullptr;
+    std::uint32_t lo = 0, hi = 0;
+
+    Sink() {
+        const char* spec = std::getenv("DREAM_TRACE_INSNS");
+        if (!spec || !*spec)
+            return;
+        char buf[512];
+        std::snprintf(buf, sizeof buf, "%s", spec);
+        char* first = std::strchr(buf, ':');
+        if (!first)
+            return;
+        char* second = std::strchr(first + 1, ':');
+        if (!second)
+            return;
+        *first = '\0';
+        *second = '\0';
+        // The range is given in either P0 (0x0C...) or P1 (0x8C...) form; the guest runs in P1.
+        lo = static_cast<std::uint32_t>(std::strtoul(buf, nullptr, 0)) & 0x1FFFFFFFu;
+        hi = static_cast<std::uint32_t>(std::strtoul(first + 1, nullptr, 0)) & 0x1FFFFFFFu;
+        file = std::fopen(second + 1, "w");
+        if (const char* f = std::getenv("DREAM_TRACE_FROM"))
+            g_from = std::strtoull(f, nullptr, 0);
+        if (const char* f = std::getenv("DREAM_TRACE_TO"))
+            g_to = std::strtoull(f, nullptr, 0);
+        if (const char* f = std::getenv("DREAM_TRACE_IDX_FROM"))
+            g_idx_from = std::strtoull(f, nullptr, 0);
+        if (const char* f = std::getenv("DREAM_TRACE_IDX_TO"))
+            g_idx_to = std::strtoull(f, nullptr, 0);
+        if (const char* f = std::getenv("DREAM_TRACE_HASH")) {
+            char buf[512];
+            std::snprintf(buf, sizeof buf, "%s", f);
+            char* colon = std::strrchr(buf, ':');
+            if (colon) {
+                *colon = 0;
+                g_hash_interval = std::strtoull(colon + 1, nullptr, 0);
+            } else {
+                g_hash_interval = 10000;
+            }
+            g_hash_file = std::fopen(buf, "w");
+        }
+    }
+
+    ~Sink() {
+        if (file)
+            std::fclose(file);
+    }
+};
+
+Sink g_sink;  // constructed at program start so the file exists even if emitted code
+              // never calls enabled() (a translated-only run has no trace hooks)
+Sink& sink() {
+    return g_sink;
+}
+
+}  // namespace
+
+bool begin_file(const char* path) noexcept {
+    Sink& s = sink();
+    if (s.file) {
+        std::fclose(s.file);
+        s.file = nullptr;
+    }
+    s.file = std::fopen(path, "w");
+    return s.file != nullptr;
