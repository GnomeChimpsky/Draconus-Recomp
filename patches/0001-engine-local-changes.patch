diff --git b/render/src/interpolate.cpp b/render/src/interpolate.cpp
new file mode 100644
index 0000000..663d4cd
--- /dev/null
+++ b/render/src/interpolate.cpp
@@ -0,0 +1,349 @@
+// See interpolate.h.
+#include "dream/render/interpolate.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <unordered_map>
+#include <vector>
+
+namespace dream::render {
+
+namespace {
+
+// What makes two strips the same piece of geometry: the vertex count and every hardware word that
+// changes how it is drawn. Position, depth, UV and colour are deliberately absent -- those are what
+// interpolation moves. A changed texture address (streaming art) or a changed ISP/TSP word makes the
+// pair unmatched, which is safer than interpolating two different surfaces.
+struct PolyKey {
+    std::uint32_t count = 0, pcw = 0, isp = 0, tsp = 0, tcw = 0, tsp1 = 0, tcw1 = 0,
+                  tile_clip = 0;
+    std::uint16_t clip_x0 = 0, clip_y0 = 0, clip_x1 = 0, clip_y1 = 0;
+    bool operator==(const PolyKey& o) const noexcept {
+        return count == o.count && pcw == o.pcw && isp == o.isp && tsp == o.tsp && tcw == o.tcw &&
+               tsp1 == o.tsp1 && tcw1 == o.tcw1 && tile_clip == o.tile_clip &&
+               clip_x0 == o.clip_x0 && clip_y0 == o.clip_y0 && clip_x1 == o.clip_x1 &&
+               clip_y1 == o.clip_y1;
+    }
+};
+
+struct PolyKeyHash {
+    std::size_t operator()(const PolyKey& k) const noexcept {
+        std::uint64_t h = k.count * 0x9E3779B185EBCA87ull;
+        const std::uint32_t words[7] = {k.pcw, k.isp, k.tsp, k.tcw, k.tsp1, k.tcw1, k.tile_clip};
+        for (std::uint32_t w : words)
+            h = (h ^ w) * 0x100000001B3ull;
+        const std::uint32_t clip =
+            static_cast<std::uint32_t>(k.clip_x0) | (static_cast<std::uint32_t>(k.clip_y0) << 8) |
+            (static_cast<std::uint32_t>(k.clip_x1) << 16) |
+            (static_cast<std::uint32_t>(k.clip_y1) << 24);
+        return static_cast<std::size_t>((h ^ clip) * 0x100000001B3ull);
+    }
+};
+
+PolyKey poly_key(const Polygon& p) {
+    PolyKey k;
+    k.count = p.count;
+    k.pcw = p.pcw;
+    k.isp = p.isp;
+    k.tsp = p.tsp;
+    k.tcw = p.tcw;
+    k.tsp1 = p.tsp1;
+    k.tcw1 = p.tcw1;
+    k.tile_clip = p.tile_clip;
+    k.clip_x0 = p.clip_x0;
+    k.clip_y0 = p.clip_y0;
+    k.clip_x1 = p.clip_x1;
+    k.clip_y1 = p.clip_y1;
+    return k;
+}
+
+// A strip's place on screen: centroid, mean w (1/z), and the mean per-corner distance to a
+// candidate. A 60 Hz camera step is a few pixels, a fast pan a few tens; 32 px accepts real motion
+// without pairing two different instances of the same art, which is what produced a warped frame
+// when this was 200. The w ratio is tight for the same reason: the same surface does not change
+// depth much in one frame, while two instances at different depths do.
+constexpr float kMaxCentroid = 32.0f;
+constexpr float kMaxMean = 48.0f;
+constexpr float kMinDepthRatio = 0.7f, kMaxDepthRatio = 1.4f;
+// A frame whose matched corners moved further than this on average is a cut or a tracking loss, not
+// motion; interpolating it would show a smear. Fall back to the current frame instead.
+constexpr float kMaxAverageMotion = 48.0f;
+
+struct Fit {
+    float cx = 0, cy = 0, w = 0;
+    bool valid = false;
+};
+
+Fit fit_polygon(const Frame& frame, const Polygon& polygon) {
+    Fit fit;
+    if (polygon.first + polygon.count > frame.vertices.size() || polygon.count == 0)
+        return fit;
+    double sx = 0, sy = 0, sw = 0;
+    std::size_t n = 0;
+    for (std::uint32_t i = 0; i < polygon.count; ++i) {
+        const Vertex& v = frame.vertices[polygon.first + i];
+        if (!std::isfinite(v.x) || !std::isfinite(v.y))
+            continue;
+        sx += v.x;
+        sy += v.y;
+        if (std::fabs(v.z) > 1e-9f)
+            sw += 1.0 / static_cast<double>(v.z);
+        ++n;
+    }
+    if (n == 0)
+        return fit;
+    fit.cx = static_cast<float>(sx / n);
+    fit.cy = static_cast<float>(sy / n);
+    fit.w = static_cast<float>(sw / n);
+    fit.valid = true;
+    return fit;
+}
+
+float mean_corner_distance(const Frame& a, const Polygon& pa, const Frame& b, const Polygon& pb) {
+    if (pa.count != pb.count || pa.count == 0)
+        return 1e9f;
+    if (pa.first + pa.count > a.vertices.size() || pb.first + pb.count > b.vertices.size())
+        return 1e9f;
+    double sum = 0;
+    for (std::uint32_t i = 0; i < pa.count; ++i) {
+        const Vertex& va = a.vertices[pa.first + i];
+        const Vertex& vb = b.vertices[pb.first + i];
+        sum += (std::fabs(static_cast<double>(va.x) - vb.x) +
+                std::fabs(static_cast<double>(va.y) - vb.y)) *
+               0.5;
+    }
+    return static_cast<float>(sum / pa.count);
+}
+
+bool plausible(const Fit& a, const Fit& b, float mean) {
+    if (!a.valid || !b.valid)
+        return false;
+    if (std::fabs(a.cx - b.cx) > kMaxCentroid || std::fabs(a.cy - b.cy) > kMaxCentroid)
+        return false;
+    if (mean > kMaxMean)
+        return false;
+    if (a.w > 1e-6f && b.w > 1e-6f) {
+        const float ratio = a.w / b.w;
+        if (ratio < kMinDepthRatio || ratio > kMaxDepthRatio)
+            return false;
+    }
+    return true;
+}
+
+void lerp_corner(const Vertex& a, Vertex& b, float t) {
+    b.x = a.x + (b.x - a.x) * t;
+    b.y = a.y + (b.y - a.y) * t;
+    // 1/w is linear in screen space, which is why the hardware interpolates depth as 1/w across a
+    // triangle. Interpolate that and convert back, so the intermediate depth matches the corner.
+    if (std::fabs(a.z) > 1e-9f && std::fabs(b.z) > 1e-9f) {
+        const float wa = 1.0f / a.z, wb = 1.0f / b.z;
+        const float w = wa + (wb - wa) * t;
+        b.z = std::fabs(w) > 1e-9f ? 1.0f / w : b.z;
+    } else {
+        b.z = a.z + (b.z - a.z) * t;
+    }
+    b.u = a.u + (b.u - a.u) * t;
+    b.v = a.v + (b.v - a.v) * t;
+}
+
+void lerp_polygon(const Frame& a, const Polygon& pa, const Polygon& pb, float t, Frame& out) {
+    for (std::uint32_t i = 0; i < pa.count; ++i)
+        lerp_corner(a.vertices[pa.first + i], out.vertices[pb.first + i], t);
+}
+
+}  // namespace
+
+bool frames_compatible(const Frame& a, const Frame& b) {
+    if (a.vertices.size() != b.vertices.size())
+        return false;
+    if (a.modifiers.size() != b.modifiers.size())
+        return false;
+    for (unsigned list = 0; list < kListCount; ++list) {
+        const auto& pa = a.lists[list];
+        const auto& pb = b.lists[list];
+        if (pa.size() != pb.size())
+            return false;
+        for (std::size_t i = 0; i < pa.size(); ++i)
+            if (!(poly_key(pa[i]) == poly_key(pb[i])) || pa[i].first != pb[i].first)
+                return false;
+    }
+    for (std::size_t i = 0; i < a.modifiers.size(); ++i) {
+        if (a.modifiers[i].isp != b.modifiers[i].isp)
+            return false;
+        for (int k = 0; k < 3; ++k) {
+            if (!std::isfinite(a.modifiers[i].x[k]) || !std::isfinite(b.modifiers[i].x[k]))
+                return false;
+        }
+    }
+    return true;
+}
+
+bool interpolate_frames(const Frame& a, const Frame& b, float t, Frame& out,
+                        InterpolationStats* stats) {
+    if (!std::isfinite(t))
+        return false;
+    t = std::min(1.0f, std::max(0.0f, t));
+    InterpolationStats local;
+    local.total = b.polygon_count() + b.modifiers.size();
+    // Start from the newer frame: unmatched strips keep its corners, so they are drawn where they
+    // are now. Only pairs that plausibly are the same strip are moved.
+    Frame result = b;
+    double motion_sum = 0;
+    std::size_t motion_count = 0;
+
+    for (unsigned list = 0; list < kListCount; ++list) {
+        if (b.lists[list].empty() || a.lists[list].empty())
+            continue;
+        std::unordered_map<PolyKey, std::vector<std::size_t>, PolyKeyHash> index;
+        index.reserve(a.lists[list].size());
+        for (std::size_t i = 0; i < a.lists[list].size(); ++i)
+            index[poly_key(a.lists[list][i])].push_back(i);
+        std::unordered_map<PolyKey, std::size_t, PolyKeyHash> cursor;
+
+        for (const Polygon& pb : b.lists[list]) {
+            const PolyKey key = poly_key(pb);
+            const auto found = index.find(key);
+            if (found == index.end())
+                continue;
+            const std::vector<std::size_t>& candidates = found->second;
+            std::size_t& next = cursor[key];
+            const Fit fb = fit_polygon(b, pb);
+            std::size_t best = static_cast<std::size_t>(-1);
+            // Take the first plausible candidate, never the closest of a far-away group: jumping
+            // to a closer-looking instance of the same art is exactly how unrelated corners get
+            // paired. Two candidates cover one culled or inserted strip of the same signature.
+            const std::size_t limit = std::min(candidates.size(), next + 2);
+            for (std::size_t c = next; c < limit; ++c) {
+                const Polygon& pa = a.lists[list][candidates[c]];
+                const Fit fa = fit_polygon(a, pa);
+                const float mean = mean_corner_distance(a, pa, b, pb);
+                if (plausible(fa, fb, mean)) {
+                    best = candidates[c];
+                    break;
+                }
+            }
+            if (best == static_cast<std::size_t>(-1))
+                continue;  // no plausible predecessor: leave this strip at its current position
+            lerp_polygon(a, a.lists[list][best], pb, t, result);
+            const Fit fa = fit_polygon(a, a.lists[list][best]);
+            motion_sum += std::fabs(fa.cx - fb.cx) + std::fabs(fa.cy - fb.cy);
+            ++motion_count;
+            ++local.matched;
+            // Candidates skipped on the way to `best` were not plausible for this strip; the next
+            // strip of the same signature starts after the pair just consumed.
+            while (next < candidates.size() && candidates[next] <= best)
+                ++next;
+        }
+    }
+
+    // Modifier volumes (shadows, volume effects) have no strip state word beyond `isp`; match them
+    // in order by depth and position, the same way.
+    if (!a.modifiers.empty() && !b.modifiers.empty()) {
+        std::size_t ai = 0;
+        for (std::size_t j = 0; j < b.modifiers.size() && ai < a.modifiers.size(); ++j) {
+            const ModifierTriangle& mb = b.modifiers[j];
+            std::size_t best = a.modifiers.size();
+            float best_distance = 0;
+            for (std::size_t k = ai; k < a.modifiers.size() && k < ai + 4; ++k) {
+                const ModifierTriangle& ma = a.modifiers[k];
+                if (ma.isp != mb.isp)
+                    continue;
+                double dx = 0, dy = 0, wa = 0, wb = 0;
+                bool finite = true;
+                for (int c = 0; c < 3; ++c) {
+                    if (!std::isfinite(ma.x[c]) || !std::isfinite(mb.x[c])) {
+                        finite = false;
+                        break;
+                    }
+                    dx += std::fabs(static_cast<double>(ma.x[c]) - mb.x[c]);
+                    dy += std::fabs(static_cast<double>(ma.y[c]) - mb.y[c]);
+                    if (std::fabs(ma.z[c]) > 1e-9f && std::fabs(mb.z[c]) > 1e-9f) {
+                        wa += 1.0 / ma.z[c];
+                        wb += 1.0 / mb.z[c];
+                    }
+                }
+                if (!finite)
+                    continue;
+                const double distance = (dx + dy) / 6.0;
+                if (distance > kMaxCentroid)
+                    continue;
+                if (wa > 1e-6 && wb > 1e-6) {
+                    const double ratio = wa / wb;
+                    if (ratio < kMinDepthRatio || ratio > kMaxDepthRatio)
+                        continue;
+                }
+                if (best == a.modifiers.size() || distance < best_distance) {
+                    best = k;
+                    best_distance = static_cast<float>(distance);
+                }
+            }
+            if (best == a.modifiers.size())
+                continue;
+            ModifierTriangle& m = result.modifiers[j];
+            const ModifierTriangle& ma = a.modifiers[best];
+            for (int c = 0; c < 3; ++c) {
+                m.x[c] = ma.x[c] + (m.x[c] - ma.x[c]) * t;
+                m.y[c] = ma.y[c] + (m.y[c] - ma.y[c]) * t;
+                if (std::fabs(ma.z[c]) > 1e-9f && std::fabs(m.z[c]) > 1e-9f) {
+                    const float w = (1.0f / ma.z[c]) + ((1.0f / m.z[c]) - (1.0f / ma.z[c])) * t;
+                    if (std::fabs(w) > 1e-9f)
+                        m.z[c] = 1.0f / w;
+                }
+            }
+            ++local.matched;
+            ai = best + 1;
+        }
+    }
+
+    if (local.matched == 0) {
+        if (stats)
+            *stats = local;
+        return false;
+    }
+    // A cut (or a tracking loss) moves every matched corner by a lot. Interpolating across it would
+    // show one scene morphing into another, which is worse than repeating the current frame.
+    if (motion_count != 0 && motion_sum / static_cast<double>(motion_count) > kMaxAverageMotion) {
+        if (stats)
+            *stats = local;
+        return false;
+    }
+
+    // The renderer derives its projection from the frame's depth range, so it has to describe the
+    // interpolated corners, not either source frame's.
+    float min_z = 0, max_z = 0;
+    bool have_z = false;
+    for (const Vertex& v : result.vertices) {
+        if (!std::isfinite(v.z))
+            continue;
+        if (!have_z) {
+            min_z = max_z = v.z;
+            have_z = true;
+        } else {
+            min_z = std::min(min_z, v.z);
+            max_z = std::max(max_z, v.z);
+        }
+    }
+    for (const ModifierTriangle& m : result.modifiers) {
+        for (int c = 0; c < 3; ++c) {
+            if (!std::isfinite(m.z[c]))
+                continue;
+            if (!have_z) {
+                min_z = max_z = m.z[c];
+                have_z = true;
+            } else {
+                min_z = std::min(min_z, m.z[c]);
+                max_z = std::max(max_z, m.z[c]);
+            }
+        }
+    }
+    result.min_z = have_z ? min_z : 0.0f;
+    result.max_z = have_z ? max_z : 0.0f;
+
+    out = std::move(result);
+    if (stats)
+        *stats = local;
+    return true;
+}
+
+}  // namespace dream::render
