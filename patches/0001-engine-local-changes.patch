+    // A degenerate or empty frame has no depth evidence.
+    CHECK(frame_uses_depth(Frame{}) == false);
+
+    // A malformed polygon that points past its vertices must not read off the end.
+    Frame past_end;
+    Polygon p;
+    p.first = 100;
+    p.count = 4;
+    past_end.lists[0].push_back(p);
+    CHECK(frame_uses_depth(past_end) == false);
