diff --git b/render/src/window_size.cpp b/render/src/window_size.cpp
new file mode 100644
index 0000000..4e550cd
--- /dev/null
+++ b/render/src/window_size.cpp
@@ -0,0 +1,45 @@
+#include "dream/render/window_size.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace dream::render {
+namespace {
+// The Dreamcast's screen, which is what the scale multiplies.
+constexpr double kGuestWidth = 640.0;
+// The height below which a window stops being usable at a normal viewing distance. It is also what
+// keeps 1x at the old 960x720 default rather than the guest's literal 640x480.
+constexpr int kMinWindowHeight = 720;
+}  // namespace
+
+WindowSize scaled_window_size(unsigned scale, double aspect) {
+    if (scale == 0)
+        scale = 1;
+    const double ratio = aspect > 0.0 ? aspect : 4.0 / 3.0;
+    // The width the scale names, then the height that aspect gives it. Doing it this way is what
+    // makes 16:9 sensible: 4x names 2560, and 2560 at 16:9 is 1440 lines, not the 1920 a 4:3
+    // render would have. A width-first size is also what keeps every step on a standard
+    // resolution: 1280x720, 1920x1080, 2560x1440.
+    int height = static_cast<int>(std::lround(kGuestWidth * scale / ratio));
+    height = std::max(height, kMinWindowHeight);
+    const int width = static_cast<int>(std::lround(height * ratio));
+    return {width, height};
+}
+
+WindowSize fit_window(WindowSize want, int max_width, int max_height) {
+    if (want.width <= 0 || want.height <= 0 || max_width <= 0 || max_height <= 0)
+        return want;
+    if (want.width <= max_width && want.height <= max_height)
+        return want;
+    const double factor = std::min(static_cast<double>(max_width) / want.width,
+                                   static_cast<double>(max_height) / want.height);
+    // Rounding can land one pixel over on the axis that did not bind, so clamp both. Flooring is
+    // not used: it would take a window that exactly fits down by one for floating-point noise.
+    const int width =
+        std::max(1, std::min(max_width, static_cast<int>(std::lround(want.width * factor))));
+    const int height =
+        std::max(1, std::min(max_height, static_cast<int>(std::lround(want.height * factor))));
+    return {width, height};
+}
+
+}  // namespace dream::render
