+void JumpPack::apply(std::uint32_t effect) {
+    last_effect = effect;
+    ++set_conditions;
+    const unsigned pow_pos = (effect >> 8) & 7u;
+    const unsigned pow_neg = (effect >> 12) & 7u;
+    const unsigned freq = (effect >> 16) & 0xFFu;
+    // The high byte is a signed inclination period. INH (bit 15) makes it negative and EXH (bit 11)
+    // clear means it is absent; without that distinction a plain jolt would be read as a ramp.
+    int inc = static_cast<int>((effect >> 24) & 0xFFu);
+    if (effect & 0x8000u)
+        inc = -inc;
+    else if (!(effect & 0x0800u))
+        inc = 0;
+    const bool continuous = (effect & 1u) != 0;
+    const float power = std::min((pow_pos + pow_neg) / 7.0f, 1.0f);
+    // Flycast's derivation: a one-shot effect lasts as long as its inclination takes at that
+    // frequency, capped by the pack's own auto-stop time. CNT with no inclination keeps running
+    // until the auto-stop.
+    const std::uint32_t stop_ms = static_cast<std::uint32_t>(auto_stop) * 250u + 250u;
+    std::uint32_t duration_ms = stop_ms;
+    if (freq > 0 && (!continuous || inc != 0)) {
+        const unsigned period = inc == 0 ? 1u : static_cast<unsigned>(inc < 0 ? -inc : inc);
+        const unsigned strength = std::max(pow_pos, pow_neg);
+        const double ms = 1000.0 * period * strength / freq;
+        duration_ms = static_cast<std::uint32_t>(std::min<double>(ms, stop_ms));
+    }
+    if (on_effect)
+        on_effect(Effect{power, duration_ms, static_cast<std::uint8_t>(freq), continuous});
+}
