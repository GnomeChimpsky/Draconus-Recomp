+// The size the presentation window opens at.
+//
+// --scale is a property of the image, not of the screen: it says how many pixels the 3D is drawn
+// at. These functions turn it into the window a player expects -- 4x is a 2560-wide window, not a
+// 960-wide one showing a 2560-wide render -- without letting a large scale open a window the
+// machine cannot show.
+#pragma once
+
+namespace dream::render {
+
+struct WindowSize {
+    int width = 0;
+    int height = 0;
+};
+
+// The window a scale asks for at `aspect` (0 means the guest's 4:3). The width follows the scale
+// (640 * scale) and the height follows the aspect, with a 720-line floor so 1x is not a postage
+// stamp. 4:3 is 960x720 at 1x and 2560x1920 at 4x; 16:9 is 1280x720 at 1x (a 2x render in the same
+// window, which supersamples vertically) and 1920x1080 / 2560x1440 at 3x / 4x.
+WindowSize scaled_window_size(unsigned scale, double aspect);
+
+// `want` shrunk, preserving its aspect, until it fits max_width x max_height. Never grows, never
+// returns a zero dimension. A 4x window is larger than a 1080p screen, so the boot asks for the
+// usable area first and opens the largest window that fits instead of one hanging off the screen.
+WindowSize fit_window(WindowSize want, int max_width, int max_height);
+
+}  // namespace dream::render
