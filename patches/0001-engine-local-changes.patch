+TEST_CASE("maple: a jump pack in the second slot is found and its effects reach the host") {
+    Rig r;
+    auto& m = r.sys.memory;
+    auto jump = std::make_unique<maple::JumpPack>();
+    maple::JumpPack* pack = jump.get();
+    r.bus.attach_expansion(0, 1, std::move(jump));
+    std::vector<maple::JumpPack::Effect> effects;
+    pack->on_effect = [&](const maple::JumpPack::Effect& e) { effects.push_back(e); };
+
+    // The controller's reply names the occupied slots: bit 1 is the pack, so a title can find it.
+    r.descriptor(0x8C100000u, 0x8C100100u, 0, maple::kDeviceRequest, {});
+    r.kick(0x8C100000u);
+    r.sys.sched.advance(400'000);
+    CHECK(((m.read32(0x8C100100u) >> 16) & 0xFFu) == 0x22u);
+    CHECK(r.bus.device_for(0, 0x02u) == pack);
+
+    // Addressed as 0x02, it identifies itself as a vibration device.
+    r.descriptor(0x8C100200u, 0x8C100300u, 0, maple::kDeviceRequest, {}, 0x02u);
+    r.kick(0x8C100200u);
+    r.sys.sched.advance(400'000);
+    CHECK((m.read32(0x8C100300u) & 0xFFu) == maple::kDeviceStatus);
+    CHECK(m.read32(0x8C100304u) == maple::kVibration);
+    CHECK(m.read32(0x8C100308u) == 0x00000101u);
+    char name[31] = {};
+    for (int i = 0; i < 30; ++i)
+        name[i] = static_cast<char>(m.read8(0x8C100316u + static_cast<std::uint32_t>(i)));
+    CHECK(std::string(name) == "Puru Puru Pack                ");
+
+    // The KallistiOS "basic thud": motor 1, forward power 7, 26 Hz, inclination 1. A one-shot
+    // effect lasts one inclination period, so 1000 * 1 * 7 / 26 ms.
+    const std::uint32_t thud = 0x011A7010u;
+    r.descriptor(0x8C100400u, 0x8C100500u, 0, maple::kSetCondition,
+                 {maple::kVibration, thud}, 0x02u);
+    r.kick(0x8C100400u);
+    r.sys.sched.advance(400'000);
+    CHECK((m.read32(0x8C100500u) & 0xFFu) == maple::kDeviceReply);
+    REQUIRE(effects.size() == 1);
+    CHECK(effects[0].power == doctest::Approx(1.0f));
+    CHECK(effects[0].frequency_hz == 26);
+    CHECK(effects[0].continuous == false);
+    CHECK(effects[0].duration_ms == 269u);
+    CHECK(pack->last_effect == thud);
+    CHECK(pack->set_conditions == 1);
+
+    // A zero effect is a stop, and the host is told so rather than left buzzing.
+    r.descriptor(0x8C100600u, 0x8C100700u, 0, maple::kSetCondition, {maple::kVibration, 0}, 0x02u);
+    r.kick(0x8C100600u);
+    r.sys.sched.advance(400'000);
+    REQUIRE(effects.size() == 2);
+    CHECK(effects[1].power == 0.0f);
+    CHECK(pack->last_effect == 0u);
+}
