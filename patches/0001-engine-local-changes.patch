+// On Windows a host fault inside the renderer or the interpolation would otherwise end the process
+// with nothing on the console. DREAM_FAULT_TRACE=1 installs a filter that prints the exception and
+// the module-relative return addresses; the link map (built with /MAP) turns those into functions.
+#if defined(_WIN32)
+// windows.h is included for the sampler, so the exception structures and the filter's signature come
+// from the SDK rather than being spelled out here.
+long __stdcall host_fault_filter(EXCEPTION_POINTERS* pointers) {
+    std::fprintf(stderr, "host fault 0x%08x at %p\n",
+                 pointers && pointers->ExceptionRecord ? pointers->ExceptionRecord->ExceptionCode
+                                                       : 0u,
+                 pointers && pointers->ExceptionRecord ? pointers->ExceptionRecord->ExceptionAddress
+                                                       : nullptr);
+    void* frames[48];
+    const unsigned short n = RtlCaptureStackBackTrace(0, 48, frames, nullptr);
+    const auto base = reinterpret_cast<std::uintptr_t>(GetModuleHandleW(nullptr));
+    for (unsigned short i = 0; i < n; ++i)
+        std::fprintf(stderr, "  rva %llx\n",
+                     static_cast<unsigned long long>(reinterpret_cast<std::uintptr_t>(frames[i]) -
+                                                     base));
+    std::fflush(stderr);
+    return 1;  // EXCEPTION_EXECUTE_HANDLER
+}
