+// since the 1990s: the face buttons in order, the shoulders as C and Z, the first stick and its
+// triggers, and hat 0 as the d-pad. It is close enough to play, and F1 rebinds it.
+constexpr const char* kGenericPadBinds =
+    ",generic pad,a:b0,b:b1,x:b2,y:b3,back:b6,start:b7,leftshoulder:b4,rightshoulder:b5,"
+    "dpup:h0.1,dpright:h0.2,dpdown:h0.4,dpleft:h0.8,leftx:a0,lefty:a1,lefttrigger:a4,"
+    "righttrigger:a5";
