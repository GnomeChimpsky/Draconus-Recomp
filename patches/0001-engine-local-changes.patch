+// See dream/runtime/hle/side_effects.h.
+#include "dream/runtime/hle/side_effects.h"
+
+namespace dream::hle {
+
+namespace {
+bool g_pending = false;
+}
+
+void note_side_effect() noexcept {
+    g_pending = true;
+}
+
+bool take_side_effect() noexcept {
+    const bool v = g_pending;
+    g_pending = false;
+    return v;
+}
