+void map_unrecognised_pads() {
+    int ng = 0;
+    SDL_JoystickID* gids = SDL_GetGamepads(&ng);
+    int nj = 0;
+    SDL_JoystickID* jids = SDL_GetJoysticks(&nj);
+    for (int i = 0; i < nj; ++i) {
+        bool known = false;
+        for (int k = 0; k < ng; ++k)
+            known = known || gids[k] == jids[i];
+        if (known)
+            continue;
+        char guid[64] = {};
+        SDL_GUIDToString(SDL_GetJoystickGUIDForID(jids[i]), guid, sizeof guid);
+        if (!guid[0])
