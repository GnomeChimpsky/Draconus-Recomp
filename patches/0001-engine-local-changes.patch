+TEST_CASE("system: a nested handler's interpreted run ends at its RTE, not at a stale PR") {
+    // Regression for the Draconus fault `0x60000040` (docs/ENGINE-CHANGES.md, patch 007).
+    //
+    // The general-exception vector is a translated stub that hands the body to the interpreter.
+    // on_untranslated used to run that body until PR, and PR at handler entry is not the handler's
+    // return address: it belongs to the interrupted code. When the interrupt is delivered inside
+    // another handler's ISR, PR is exactly the address the handler's own `jsr` returns to, so the
+    // body was abandoned at its call, its context frame still on the guest stack, and the guest's
+    // epilogue then popped SPC/SSR one slot out of step -- an SR value loaded into SPC, an `rte`
+    // to 0x60000040, and a run that stopped at frame 54.
+    //
+    // The handler here has the same shape: push a register, call an ISR, pop it, mark completion,
+    // acknowledge the source, RTE. Its call return address is forced to equal the stale PR.
+    System sys;
+    sys.install();
+    auto& c = sys.ctx;
+    auto& m = sys.memory;
+    // VBR 0x8C00F200 puts the general-exception handler at 0x8C00F800, which no test registers as
+    // a native function: the only way in is on_untranslated -> the interpreter.
+    c.vbr = 0x8C00F200u;
+    sh4::write_sr(c, 0x40000000u);
+    // The exception entry sets SR.RB, so the handler runs on register bank 1: that is where its
+    // arguments must be, exactly as the guest's own stub expects.
+    c.r_bank[1] = 0x8C100000u;  // where the handler records that it reached its epilogue
+    c.r_bank[3] = 0x8C00F820u;  // the ISR the handler calls
+    c.r_bank[4] = 0xA05F6900u;  // VBlank-in acknowledge register
+    c.r[15] = 0x8C010000u;
+    c.pc = 0x8C010100u;     // interrupted pc, must be restored by the handler's RTE
+    c.pr = 0x8C00F806u;     // stale PR == the return address of the handler's own `jsr` at 0xF802
+    const std::uint16_t handler[] = {
+        0x2F26,  // 0x8C00F800 mov.l r2,@-r15
+        0x430B,  // 0x8C00F802 jsr @r3        (return address 0x8C00F806)
+        0x0009,  // 0x8C00F804 nop           (delay slot)
+        0x62F6,  // 0x8C00F806 mov.l @r15+,r2
+        0xE001,  // 0x8C00F808 mov #1,r0
+        0x2102,  // 0x8C00F80A mov.l r0,@r1   (completion marker)
+        0xE008,  // 0x8C00F80C mov #8,r0
+        0x2402,  // 0x8C00F80E mov.l r0,@r4   (acknowledge VBlank-in)
+        0x002B,  // 0x8C00F810 rte
+        0x0009,  // 0x8C00F812 nop           (RTE's delay slot)
+    };
+    for (std::size_t i = 0; i < sizeof handler / sizeof handler[0]; ++i)
+        m.write16(0x8C00F800u + static_cast<std::uint32_t>(2 * i), handler[i]);
+    m.write16(0x8C00F820u, 0x000B);  // rts
+    m.write16(0x8C00F822u, 0x0009);  // nop
+    m.write32(0xA05F6930u, 0x8u);    // VBlank-in -> IRL9
+    c.cycles = sys.spg.line_cycles() * 261;
+    sh4::deliver_irq(c, m);
+    // The handler ran to its RTE: the marker was written, the interrupted context returned.
+    CHECK(m.read32(0x8C100000u) == 1u);
+    CHECK(c.r[15] == 0x8C010000u);
+    CHECK(c.pc == 0x8C010100u);
+    CHECK(sys.task_switch_rtes == 0);
+    CHECK(sys.interrupts_delivered == 1);
+    CHECK(!sys.holly.raised(holly::Irq::VBlankIn));
+    sh4::set_hooks(nullptr);
+}
