+// one depth; a 3D frame has depth across its polygons, which is what the title's widened projection
+// was applied to. Getting this backwards either pillarboxes gameplay or stretches the menus.
+TEST_CASE("frame_uses_depth tells a flat 2D screen from a 3D scene") {
+    auto quad = [](float z) {
+        Frame frame;
+        Polygon p;
+        p.first = 0;
+        p.count = 4;
+        for (int i = 0; i < 4; ++i) {
+            Vertex v;
+            v.z = z;
+            frame.vertices.push_back(v);
+        }
+        frame.lists[0].push_back(p);
+        return frame;
+    };
