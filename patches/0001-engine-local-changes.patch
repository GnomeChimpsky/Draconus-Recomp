+    // A title screen or menu: every quad at the same depth, however many there are.
+    Frame flat;
+    for (int i = 0; i < 50; ++i) {
+        Polygon p;
+        p.first = static_cast<u32>(flat.vertices.size());
+        p.count = 4;
+        for (int k = 0; k < 4; ++k) {
+            Vertex v;
+            v.z = 1.0f;
+            flat.vertices.push_back(v);
+        }
+        flat.lists[0].push_back(p);
+    }
