+#pragma once
+
+#include <cstdint>
+
+namespace dream::sh4 {
+struct Ctx;
+}
+
+namespace dream::trace {
+
+// Instruction-level differential tracing.
+//
+// `DREAM_TRACE_INSNS=lo:hi:FILE` records every executed guest instruction whose address is in
+// [lo, hi) to FILE, one line per instruction. Translated code only carries the call when it was
+// generated with `--trace-insns lo:hi`; interpreted code checks the same range at run time. The
+// two runs can then be diffed to the first instruction where the engines part, which is what the
+// function-level replay harness cannot localise.
+//
+// Off and effectively free unless the variable is set.
+bool enabled() noexcept;
+
+// Within-run differential: the replay harness opens a file for the translated execution, closes
+// it, then opens another for the interpreted execution of the same call. Overrides the env var.
+bool begin_file(const char* path) noexcept;
+void end_file() noexcept;
+void insn(const sh4::Ctx& c, std::uint32_t pc) noexcept;
+
+// DREAM_TRACE_SSR=1 logs every write to SSR with its origin and the writing PC. Used to find
+// which path produces a corrupt SSR (the open fault restores PC from it).
+void ssr_write(const char* tag, std::uint32_t pc, std::uint32_t value) noexcept;
+
+// DREAM_TRACE_SR=1 logs every write to SR with the PC in c.pc (the current instruction when the
+// interpreter runs, the last transfer when emitted code runs) and the value written.
+void sr_write(const sh4::Ctx& c, std::uint32_t value) noexcept;
+
+// DREAM_TRACE_SPC=1 logs every write to SPC with its origin and the writing PC.
+void spc_write(const char* tag, std::uint32_t pc, std::uint32_t value) noexcept;
+
+}  // namespace dream::trace
