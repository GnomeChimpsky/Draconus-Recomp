diff --git b/runtime/src/trace.cpp b/runtime/src/trace.cpp
new file mode 100644
index 0000000..dc549be
--- /dev/null
+++ b/runtime/src/trace.cpp
@@ -0,0 +1,155 @@
+// See dream/runtime/trace.h.
+#include "dream/runtime/trace.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include "dream/runtime/sh4/ctx.h"
+
+namespace dream::trace {
+
+namespace {
+
+std::uint64_t g_from = 0;  // DREAM_TRACE_FROM: ignore instructions before this guest cycle
+std::uint64_t g_to = ~0ull;
+std::uint64_t g_index = 0;        // instructions traced so far, identical in both engines
+std::uint64_t g_idx_from = 0, g_idx_to = ~0ull;
+std::uint64_t g_hash = 1469598103934665603ull;  // FNV-1a over (pc, r0-r15, sr, t)
+std::uint64_t g_hash_interval = 0;              // DREAM_TRACE_HASH: checkpoint every N
+FILE* g_hash_file = nullptr;  // DREAM_TRACE_TO: stop recording after this guest cycle
+
+struct Sink {
+    FILE* file = nullptr;
+    std::uint32_t lo = 0, hi = 0;
+
+    Sink() {
+        const char* spec = std::getenv("DREAM_TRACE_INSNS");
+        if (!spec || !*spec)
+            return;
+        char buf[512];
+        std::snprintf(buf, sizeof buf, "%s", spec);
+        char* first = std::strchr(buf, ':');
+        if (!first)
+            return;
+        char* second = std::strchr(first + 1, ':');
+        if (!second)
+            return;
+        *first = '\0';
+        *second = '\0';
+        // The range is given in either P0 (0x0C...) or P1 (0x8C...) form; the guest runs in P1.
+        lo = static_cast<std::uint32_t>(std::strtoul(buf, nullptr, 0)) & 0x1FFFFFFFu;
+        hi = static_cast<std::uint32_t>(std::strtoul(first + 1, nullptr, 0)) & 0x1FFFFFFFu;
+        file = std::fopen(second + 1, "w");
+        if (const char* f = std::getenv("DREAM_TRACE_FROM"))
+            g_from = std::strtoull(f, nullptr, 0);
+        if (const char* f = std::getenv("DREAM_TRACE_TO"))
+            g_to = std::strtoull(f, nullptr, 0);
+        if (const char* f = std::getenv("DREAM_TRACE_IDX_FROM"))
+            g_idx_from = std::strtoull(f, nullptr, 0);
+        if (const char* f = std::getenv("DREAM_TRACE_IDX_TO"))
+            g_idx_to = std::strtoull(f, nullptr, 0);
+        if (const char* f = std::getenv("DREAM_TRACE_HASH")) {
+            char buf[512];
+            std::snprintf(buf, sizeof buf, "%s", f);
+            char* colon = std::strrchr(buf, ':');
+            if (colon) {
+                *colon = 0;
+                g_hash_interval = std::strtoull(colon + 1, nullptr, 0);
+            } else {
+                g_hash_interval = 10000;
+            }
+            g_hash_file = std::fopen(buf, "w");
+        }
+    }
+
+    ~Sink() {
+        if (file)
+            std::fclose(file);
+    }
+};
+
+Sink g_sink;  // constructed at program start so the file exists even if emitted code
+              // never calls enabled() (a translated-only run has no trace hooks)
+Sink& sink() {
+    return g_sink;
+}
+
+}  // namespace
+
+bool begin_file(const char* path) noexcept {
+    Sink& s = sink();
+    if (s.file) {
+        std::fclose(s.file);
+        s.file = nullptr;
+    }
+    s.file = std::fopen(path, "w");
+    return s.file != nullptr;
+}
+
+void end_file() noexcept {
+    Sink& s = sink();
+    if (s.file) {
+        std::fclose(s.file);
+        s.file = nullptr;
+    }
+}
+
+bool enabled() noexcept {
+    return sink().file != nullptr;
+}
+
+void insn(const sh4::Ctx& c, std::uint32_t pc) noexcept {
+    Sink& s = sink();
+    if (!s.file || (pc & 0x1FFFFFFFu) < s.lo || (pc & 0x1FFFFFFFu) >= s.hi)
+        return;
+    const std::uint64_t idx = g_index++;
+    // Checkpoint hash: covers the same fields on both engines, so the first differing checkpoint
+    // names the instruction window where they part, in bounded memory.
+    // Normalise the P0/P1 alias, or the same instruction hashes differently in each engine.
+    g_hash = (g_hash ^ (pc & 0x1FFFFFFFu)) * 1099511628211ull;
+    // Only the stack pointer, not every register: a register that differs but never affects
+    // control flow or the stack is not a behavioural difference (MOVA's P0/P1 alias is one).
+    g_hash = (g_hash ^ c.r[15]) * 1099511628211ull;
+    g_hash = (g_hash ^ c.sr) * 1099511628211ull;
+    g_hash = (g_hash ^ (c.t ? 1u : 0u)) * 1099511628211ull;
+    if (g_hash_file && g_hash_interval && idx % g_hash_interval == 0)
+        std::fprintf(g_hash_file, "ck %llu %016llx %llu\n",
+                     static_cast<unsigned long long>(idx),
+                     static_cast<unsigned long long>(g_hash),
+                     static_cast<unsigned long long>(c.cycles));
+    if (idx < g_idx_from || idx > g_idx_to)
+        return;
+    if (c.cycles < g_from || c.cycles > g_to)
+        return;
+    // Every register, then the control state, so a divergence anywhere is caught at the instruction
+    // where it happens rather than at the next printed field.
+    std::fprintf(s.file, "%08x %llu", pc,
+                 static_cast<unsigned long long>(c.cycles));
+    for (int i = 0; i < 16; ++i) std::fprintf(s.file, " %08x", c.r[i]);
+    std::fprintf(s.file, " %u %08x %08x %08x %08x %08x %08x\n", c.t ? 1u : 0u, c.sr, c.spc, c.ssr,
+                 c.fpscr, c.pr, c.gbr);
+}
+
+void ssr_write(const char* tag, std::uint32_t pc, std::uint32_t value) noexcept {
+    static const bool on = std::getenv("DREAM_TRACE_SSR") != nullptr;
+    if (!on)
+        return;
+    std::fprintf(stderr, "ssr-write %-10s pc 0x%08x value 0x%08x\n", tag, pc, value);
+}
+
+void sr_write(const sh4::Ctx& c, std::uint32_t value) noexcept {
+    static const bool on = std::getenv("DREAM_TRACE_SR") != nullptr;
+    if (!on)
+        return;
+    std::fprintf(stderr, "sr-write pc 0x%08x value 0x%08x old 0x%08x\n", c.pc, value, c.sr);
+}
+
+void spc_write(const char* tag, std::uint32_t pc, std::uint32_t value) noexcept {
+    static const bool on = std::getenv("DREAM_TRACE_SPC") != nullptr;
+    if (!on)
+        return;
+    std::fprintf(stderr, "spc-write %-10s pc 0x%08x value 0x%08x\n", tag, pc, value);
+}
+
+}  // namespace dream::trace
