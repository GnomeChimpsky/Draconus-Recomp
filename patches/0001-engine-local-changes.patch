diff --git b/render/include/dream/render/interpolate.h b/render/include/dream/render/interpolate.h
new file mode 100644
index 0000000..b2463d3
--- /dev/null
+++ b/render/include/dream/render/interpolate.h
@@ -0,0 +1,45 @@
+// Between-frame interpolation for a title whose simulation runs at 60 Hz while the display runs
+// faster (see --frame-interpolation).
+//
+// The renderer receives geometry the guest has already transformed: every vertex is in screen space
+// with 1/w depth and a texture coordinate. Two consecutive frames of a scene therefore carry the
+// same corners twice, and a corner in the middle of its motion is just the ratio between the two.
+// Interpolating the vertex stream is a geometry interpolation, not a picture blend: the intermediate
+// frame is rasterised and depth-tested normally, so a moving edge stays an edge and nothing ghosts.
+//
+// Consecutive frames are not identical, though. Frustum culling drops a strip here and adds one
+// there, a texture address changes as the title streams art, and a HUD element is rewritten. Pairs
+// are therefore matched polygon by polygon on their render state, in submission order, and a pair
+// is only used when its corners are close enough that it is plausibly the same piece of geometry.
+// Polygons with no match are drawn at their current position, so a pop is possible but a smear is
+// not. When too little of the frame matches, the caller presents the current frame unchanged.
+#pragma once
+
+#include <cstddef>
+
+#include "dream/render/display_list.h"
+
+namespace dream::render {
+
+// How much of the newer frame had a counterpart in the older one. The caller can use the ratio to
+// decide whether the result is worth presenting, and diagnostics print it.
+struct InterpolationStats {
+    std::size_t matched = 0;
+    std::size_t total = 0;  // polygons in the newer frame, plus its modifier triangles
+};
+
+// Whether two consecutive frames carry exactly the same geometry structure, so that vertex i of
+// `a` corresponds to vertex i of `b`. This is the strict form, useful as a diagnostic and in tests;
+// interpolate_frames() no longer requires it, because one culled strip would otherwise reject the
+// whole frame.
+bool frames_compatible(const Frame& a, const Frame& b);
+
+// Writes the frame at `t` between `a` (t=0) and `b` (t=1): corners present in both are moved,
+// corners that only exist in `b` stay where they are, and corners that only exist in `a` are
+// dropped. Render state, colours and clip rectangles come from `b`. `t` is clamped to [0, 1]. The
+// depth range is recomputed from the result, because the renderer derives its projection from it.
+// Returns false when no pair matched (or `t` is not finite), leaving `out` untouched.
+bool interpolate_frames(const Frame& a, const Frame& b, float t, Frame& out,
+                        InterpolationStats* stats = nullptr);
+
+}  // namespace dream::render
