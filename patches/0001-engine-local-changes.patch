+    // The dimming rectangle is the only translucent thing on this screen, and it covers every
+    // pixel of the frame. Taking its blend destination from the write-combined staging buffer it
+    // is stamped into would cost an uncached read per pixel of the whole frame -- at --scale 4 that
+    // is 5 million of them. `under` is the same picture in cached memory.
+    InputMenu m = opened();
+    const std::vector<std::string> devices{"KEYBOARD", "TEST PAD"};
+    constexpr std::uint32_t kPoison = 0xDEADBEEFu;
+    // The frame the menu is drawn over, and where the shade must get its colour from.
+    std::vector<std::uint32_t> frame(64 * 48, 0xFFFFFFFFu);
+    // Drawn in place, over a copy of the frame...
+    auto inplace = frame;
+    m.draw(inplace.data(), 64, 64, 48, devices);
+    // ...against drawn over nothing but poison, told what the frame is.
+    std::vector<std::uint32_t> apart(64 * 48, kPoison);
+    m.draw(apart.data(), 64, 64, 48, devices, frame.data());
+    CHECK(apart == inplace);
+    // And the poison really was never read. (0,0) is outside the card, so it is the frame dimmed by
+    // the shade -- a value no blend of the poison could produce.
+    CHECK(apart[0] == inplace[0]);
+    CHECK(((apart[0] >> 0) & 0xFFu) == 75);  // 0xB4000000 black over white
+}
diff --git b/render/tests/test_interpolate.cpp b/render/tests/test_interpolate.cpp
new file mode 100644
index 0000000..7c0d3f6
--- /dev/null
+++ b/render/tests/test_interpolate.cpp
@@ -0,0 +1,198 @@
+// Between-frame interpolation: the geometry half, which needs no GPU and runs on every CI runner.
+#include "dream/render/interpolate.h"
+
+#include <algorithm>
+
+#include "doctest.h"
+
+using namespace dream::render;
+
+namespace {
+
+Vertex vertex(float x, float y, float z, float u = 0.0f, float v = 0.0f) {
+    Vertex out;
+    out.x = x;
+    out.y = y;
+    out.z = z;
+    out.u = u;
+    out.v = v;
+    return out;
+}
+
+// A three-vertex strip in the opaque list, which is all an interpolation test needs.
+Frame strip(float x0, float x1, float z0, float z1) {
+    Frame frame;
+    frame.vertices = {vertex(x0, 10.0f, z0, 0.0f, 0.0f), vertex(x1, 10.0f, z1, 1.0f, 0.0f),
+                      vertex(x0, 90.0f, z0, 0.0f, 1.0f)};
+    Polygon polygon;
+    polygon.first = 0;
+    polygon.count = 3;
+    polygon.pcw = 0x12345678u;
+    polygon.isp = 0x00000011u;
+    polygon.tsp = 0x22222222u;
+    polygon.tcw = 0x33333333u;
+    frame.lists[0].push_back(polygon);
+    frame.min_z = std::min(z0, z1);
+    frame.max_z = std::max(z0, z1);
+    frame.strips = 1;
+    return frame;
+}
+
+}  // namespace
+
+TEST_CASE("interpolate: identical geometry is compatible") {
+    const Frame a = strip(10.0f, 100.0f, 0.5f, 0.25f);
+    const Frame b = strip(10.0f, 100.0f, 0.5f, 0.25f);
+    CHECK(frames_compatible(a, b));
+    Frame out;
+    REQUIRE(interpolate_frames(a, b, 0.5f, out));
+    CHECK(out.vertices.size() == 3);
+    CHECK(out.vertices[1].x == doctest::Approx(100.0));
+}
+
+TEST_CASE("interpolate: a moved corner lands halfway") {
+    const Frame a = strip(10.0f, 100.0f, 0.5f, 0.25f);
+    const Frame b = strip(30.0f, 140.0f, 0.5f, 0.25f);
+    REQUIRE(frames_compatible(a, b));
+    Frame out;
+    REQUIRE(interpolate_frames(a, b, 0.5f, out));
+    CHECK(out.vertices[0].x == doctest::Approx(20.0));
+    CHECK(out.vertices[1].x == doctest::Approx(120.0));
+    CHECK(out.vertices[0].y == doctest::Approx(10.0));
+    CHECK(out.vertices[2].y == doctest::Approx(90.0));
+}
+
+TEST_CASE("interpolate: depth moves in w, not in 1/w") {
+    // z is 1/w, and w is what is linear in screen space. Halfway between w=2 (z=0.5) and w=2.5
+    // (z=0.4) is w=2.25, so the interpolated z is 1/2.25 rather than the 0.45 a naive lerp gives.
+    const Frame a = strip(0.0f, 10.0f, 0.5f, 0.5f);
+    const Frame b = strip(0.0f, 10.0f, 0.4f, 0.4f);
+    Frame out;
+    REQUIRE(interpolate_frames(a, b, 0.5f, out));
+    CHECK(out.vertices[0].z == doctest::Approx(1.0 / 2.25));
+    CHECK(out.max_z == doctest::Approx(1.0 / 2.25));
+}
+
+TEST_CASE("interpolate: texture coordinates move with the corner") {
+    Frame a = strip(0.0f, 10.0f, 0.5f, 0.5f);
+    Frame b = a;
+    a.vertices[1].u = 0.0f;
+    b.vertices[1].u = 1.0f;
+    Frame out;
+    REQUIRE(interpolate_frames(a, b, 0.25f, out));
+    CHECK(out.vertices[1].u == doctest::Approx(0.25));
+}
+
+TEST_CASE("interpolate: state and colours come from the newer frame") {
+    Frame a = strip(0.0f, 10.0f, 0.5f, 0.5f);
+    Frame b = strip(0.0f, 10.0f, 0.5f, 0.5f);
+    a.vertices[0].base = 0xFF000000u;
+    b.vertices[0].base = 0xFFFFFFFFu;
+    Frame out;
+    REQUIRE(interpolate_frames(a, b, 0.5f, out));
+    CHECK(out.vertices[0].base == 0xFFFFFFFFu);
+    CHECK(out.lists[0][0].tsp == b.lists[0][0].tsp);
+}
+
+TEST_CASE("interpolate: modifiers move too and count towards the depth range") {
+    Frame a = strip(0.0f, 10.0f, 1.0f, 1.0f);
+    Frame b = a;
+    ModifierTriangle ma;
+    ma.x[0] = 0.0f;
+    ma.z[0] = 1.0f;
+    ma.x[1] = 10.0f;
+    ma.z[1] = 1.0f;
+    ma.x[2] = 0.0f;
+    ma.z[2] = 1.0f;
+    a.modifiers.push_back(ma);
+    ModifierTriangle mb = ma;
+    mb.x[0] = 20.0f;
+    mb.z[0] = 0.8f;
+    mb.x[1] = 30.0f;
+    mb.z[1] = 0.8f;
+    mb.x[2] = 20.0f;
+    mb.z[2] = 0.8f;
+    b.modifiers.push_back(mb);
+    Frame out;
+    REQUIRE(interpolate_frames(a, b, 0.5f, out));
+    CHECK(out.modifiers[0].x[0] == doctest::Approx(10.0));
+    CHECK(out.min_z == doctest::Approx(1.0 / 1.125));
+}
+
+TEST_CASE("interpolate: a culled or changed polygon is not interpolated") {
+    const Frame a = strip(0.0f, 10.0f, 0.5f, 0.5f);
+    Frame fewer = a;
+    fewer.vertices.pop_back();
+    CHECK_FALSE(frames_compatible(a, fewer));
+
+    Frame different_state = a;
+    different_state.lists[0][0].isp ^= 0x1u;
+    CHECK_FALSE(frames_compatible(a, different_state));
+
+    Frame another_strip = a;
+    another_strip.lists[0].push_back(a.lists[0][0]);
+    CHECK_FALSE(frames_compatible(a, another_strip));
+
+    Frame different_modifiers = a;
+    ModifierTriangle m;
+    different_modifiers.modifiers.push_back(m);
+    CHECK_FALSE(frames_compatible(a, different_modifiers));
+}
+
+TEST_CASE("interpolate: a strip that only exists in the newer frame stays put") {
+    Frame a = strip(0.0f, 10.0f, 0.5f, 0.5f);
+    Frame b = a;
+    Polygon second;
+    second.first = 3;
+    second.count = 3;
+    second.pcw = 0x87654321u;  // a different signature, so it cannot pair with the first strip
+    for (int i = 0; i < 3; ++i)
+        b.vertices.push_back(vertex(500.0f + i, 20.0f, 0.5f));
+    b.lists[0].push_back(second);
+    InterpolationStats stats;
+    Frame out;
+    REQUIRE(interpolate_frames(a, b, 0.5f, out, &stats));
+    CHECK(stats.matched == 1);
+    CHECK(stats.total == 2);
+    CHECK(out.vertices[3].x == doctest::Approx(500.0));
+}
+
+TEST_CASE("interpolate: a strip that disappeared is not resurrected") {
+    Frame b = strip(0.0f, 10.0f, 0.5f, 0.5f);
+    Frame a = b;
+    Polygon extra = a.lists[0][0];
+    extra.first = 3;
+    for (int i = 0; i < 3; ++i)
+        a.vertices.push_back(vertex(700.0f + i, 20.0f, 0.5f));
+    a.lists[0].push_back(extra);
+    InterpolationStats stats;
+    Frame out;
+    REQUIRE(interpolate_frames(a, b, 0.5f, out, &stats));
+    CHECK(stats.matched == 1);
+    CHECK(stats.total == 1);
+    CHECK(out.vertices.size() == b.vertices.size());
+}
+
+TEST_CASE("interpolate: a same-shaped pair too far apart is not matched") {
+    // Same strip state and vertex count, but a screen apart: almost certainly a different object
+    // that happens to share the art, so it must keep the newer position rather than smear.
+    const Frame a = strip(0.0f, 10.0f, 0.5f, 0.5f);
+    const Frame b = strip(1000.0f, 1010.0f, 0.5f, 0.5f);
+    Frame out;
+    out.strips = 99;
+    InterpolationStats stats;
+    CHECK_FALSE(interpolate_frames(a, b, 0.5f, out, &stats));
+    CHECK(out.strips == 99);
+    CHECK(stats.matched == 0);
+    CHECK(stats.total == 1);
+}
+
+TEST_CASE("interpolate: t is clamped") {
+    const Frame a = strip(0.0f, 10.0f, 0.5f, 0.5f);
+    const Frame b = strip(20.0f, 30.0f, 0.5f, 0.5f);
+    Frame out;
+    REQUIRE(interpolate_frames(a, b, -1.0f, out));
+    CHECK(out.vertices[0].x == doctest::Approx(0.0));
+    REQUIRE(interpolate_frames(a, b, 2.0f, out));
+    CHECK(out.vertices[0].x == doctest::Approx(20.0));
+}
diff --git a/render/tests/test_overlay.cpp b/render/tests/test_overlay.cpp
index c18486d..beec426 100644
--- a/render/tests/test_overlay.cpp
+++ b/render/tests/test_overlay.cpp
@@ -117,3 +117,47 @@ TEST_CASE("a zero scale draws nothing rather than dividing by it") {
     CHECK(c == before);
     CHECK(text_width("X", 0) == 0);
 }
+
+TEST_CASE("an overlay takes its blend destination from `under`, not from the buffer it writes") {
+    // The counter is stamped into the presenter's staging buffer, which is write-combined: a
+    // read-modify-write there costs an uncached round trip per pixel, ~9.5 ms a frame at --scale 4.
+    // A destination full of poison proves the write path never looks at what it is overwriting.
+    constexpr u32 kPoison = 0xDEADBEEFu;
+    std::vector<u32> frame(kW * kH, kWhite);
+    std::vector<u32> staged(kW * kH, kPoison);
+    draw_text(staged.data(), kW, kW, kH, 4, 4, "8", TextStyle{kBlack, 0x80000000u, 1},
+              frame.data());
+    // The panel is translucent, so this pixel could only come from the frame's white: black over it
+    // at 128/255 is 127. Had the poison been read, it would not be black-composited at all.
+    CHECK(((staged[4 * kW + 3] >> 0) & 0xFFu) == 127);
+    CHECK(((staged[4 * kW + 3] >> 24) & 0xFFu) == 255);
+    // A glyph is opaque and covers whatever was underneath.
+    CHECK(staged[4 * kW + 5] == kBlack);
+    // Nothing outside the panel is touched.
+    CHECK(staged[0] == kPoison);
+}
+
+TEST_CASE("drawing over `under` is pixel-identical to drawing over the frame itself") {
+    // The two ways of compositing must agree exactly: one stamps into a copy of the frame, the
+    // other stamps into a buffer that starts as anything at all and is told what the frame is.
+    std::vector<u32> frame(kW * kH);
+    for (std::size_t i = 0; i < frame.size(); ++i)
+        frame[i] = 0xFF000000u | ((static_cast<u32>(i) * 2654435761u) & 0x00FFFFFFu);
+    auto inplace = frame;
+    draw_text(inplace.data(), kW, kW, kH, 3, 2, "88.8 FPS", TextStyle{kWhite, 0xC0000000u, 1});
+    std::vector<u32> apart(kW * kH, 0xFFFFFFFFu);
+    draw_text(apart.data(), kW, kW, kH, 3, 2, "88.8 FPS", TextStyle{kWhite, 0xC0000000u, 1},
+              frame.data());
+    // Exactly the rectangle draw_text's background panel covers: one pixel of margin either side
+    // of the text at scale 1, and the glyphs sit inside it.
+    const int x0 = 3 - 1, y0 = 2 - 1;
+    const int pw = static_cast<int>(text_width("88.8 FPS", 1)) + 1;
+    const int ph = static_cast<int>(text_height(1)) + 1;
+    for (int y = y0; y < y0 + ph; ++y)
+        for (int x = x0; x < x0 + pw; ++x) {
+            const std::size_t i =
+                static_cast<std::size_t>(y) * kW + static_cast<std::size_t>(x);
+            INFO("pixel " << x << "," << y);
+            CHECK(apart[i] == inplace[i]);
+        }
+}
diff --git b/render/tests/test_present_rate.cpp b/render/tests/test_present_rate.cpp
new file mode 100644
index 0000000..6e03479
--- /dev/null
+++ b/render/tests/test_present_rate.cpp
@@ -0,0 +1,34 @@
+// --present-rate arithmetic: the display's refresh is the ceiling, because presenting more frames
+// than it can show only makes the guest wait.
+#include "dream/render/present_rate.h"
+
+#include "doctest.h"
+
+using dream::render::presents_per_frame;
+
+TEST_CASE("present rate: the default is one present per guest frame") {
+    CHECK(presents_per_frame(0, 165.0) == doctest::Approx(1.0));
+    CHECK(presents_per_frame(0, 60.0) == doctest::Approx(1.0));
+    CHECK(presents_per_frame(0, 0.0) == doctest::Approx(1.0));
+}
+
+TEST_CASE("present rate: below the refresh, the request is used as asked") {
+    CHECK(presents_per_frame(120, 165.0) == doctest::Approx(2.0));
+    CHECK(presents_per_frame(144, 165.0) == doctest::Approx(2.4));
+    CHECK(presents_per_frame(120, 120.0) == doctest::Approx(2.0));
+    CHECK(presents_per_frame(60, 165.0) == doctest::Approx(1.0));
+}
+
+TEST_CASE("present rate: a slower display caps the request") {
+    // The reported defect: 120 presents on a 60 Hz panel is two vblanks per guest frame, which is
+    // half speed. Capped, it is one present per frame -- the same as off, at 60 Hz.
+    CHECK(presents_per_frame(120, 60.0) == doctest::Approx(1.0));
+    CHECK(presents_per_frame(144, 60.0) == doctest::Approx(1.0));
+    CHECK(presents_per_frame(144, 120.0) == doctest::Approx(2.0));
+    CHECK(presents_per_frame(120, 59.94) == doctest::Approx(0.999));
+}
+
+TEST_CASE("present rate: an unknown refresh does not cap") {
+    CHECK(presents_per_frame(120, 0.0) == doctest::Approx(2.0));
+    CHECK(presents_per_frame(144, 0.0) == doctest::Approx(2.4));
+}
diff --git b/render/tests/test_window_size.cpp b/render/tests/test_window_size.cpp
new file mode 100644
index 0000000..707e6bc
--- /dev/null
+++ b/render/tests/test_window_size.cpp
@@ -0,0 +1,62 @@
+// The window size policy. It is a pure function of the scale, the aspect and the display, which is
+// why it is tested as numbers here rather than by opening windows.
+#include "dream/render/window_size.h"
+
+#include <cmath>
+
+#include "doctest.h"
+
+using dream::render::fit_window;
+using dream::render::scaled_window_size;
+
+TEST_CASE("window size: 4:3 follows the scale") {
+    // 1x keeps the old default: the guest's 640x480 is not a comfortable window any more.
+    CHECK(scaled_window_size(1, 0.0).width == 960);
+    CHECK(scaled_window_size(1, 0.0).height == 720);
+    CHECK(scaled_window_size(2, 0.0).width == 1280);
+    CHECK(scaled_window_size(2, 0.0).height == 960);
+    CHECK(scaled_window_size(3, 0.0).width == 1920);
+    CHECK(scaled_window_size(3, 0.0).height == 1440);
+    CHECK(scaled_window_size(4, 0.0).width == 2560);
+    CHECK(scaled_window_size(4, 0.0).height == 1920);
+    // An aspect of exactly 4:3 is the same as none at all.
+    CHECK(scaled_window_size(4, 4.0 / 3.0).width == 2560);
+    CHECK(scaled_window_size(4, 4.0 / 3.0).height == 1920);
+}
+
+TEST_CASE("window size: widescreen keeps the width and takes the height out of it") {
+    // 4x 16:9 is 2560x1440, the size of a 1440p monitor, not 3413x1920.
+    CHECK(scaled_window_size(4, 16.0 / 9.0).width == 2560);
+    CHECK(scaled_window_size(4, 16.0 / 9.0).height == 1440);
+    CHECK(scaled_window_size(3, 16.0 / 9.0).width == 1920);
+    CHECK(scaled_window_size(3, 16.0 / 9.0).height == 1080);
+    // 1x and 2x share the 720-line floor: the 2x render is the same window, supersampled.
+    CHECK(scaled_window_size(1, 16.0 / 9.0).width == 1280);
+    CHECK(scaled_window_size(1, 16.0 / 9.0).height == 720);
+    CHECK(scaled_window_size(2, 16.0 / 9.0).width == 1280);
+    CHECK(scaled_window_size(2, 16.0 / 9.0).height == 720);
+    // An ultrawide aspect is still width-first: 21:9 at 4x is 2560 wide.
+    CHECK(scaled_window_size(4, 21.0 / 9.0).width == 2560);
+    CHECK(scaled_window_size(4, 21.0 / 9.0).height == 1097);
+}
+
+TEST_CASE("window size: a scale larger than the display is shrunk to fit") {
+    const auto screen = scaled_window_size(4, 16.0 / 9.0);  // 2560x1440
+    // A 90% budget on a 2560x1392 work area: 2304x1252 is the box, the 16:9 window fits inside it.
+    const auto fitted = fit_window(screen, 2304, 1252);
+    CHECK(fitted.width == 2226);
+    CHECK(fitted.height == 1252);
+    // Aspect is preserved to rounding, not to the pixel: the integer size cannot be exactly 16:9.
+    CHECK(std::fabs(static_cast<double>(fitted.width) / fitted.height - 16.0 / 9.0) < 0.001);
+
+    // A window that already fits is not touched -- not even by a pixel.
+    CHECK(fit_window({1280, 720}, 2304, 1252).width == 1280);
+    CHECK(fit_window({1280, 720}, 2304, 1252).height == 720);
+    // A screen too small to be useful still gets a positive window rather than a zero one.
+    const auto tiny = fit_window({2560, 1440}, 1, 1);
+    CHECK(tiny.width >= 1);
+    CHECK(tiny.height >= 1);
+    // No display information is not a reason to change anything.
+    CHECK(fit_window({2560, 1440}, 0, 0).width == 2560);
+    CHECK(fit_window({2560, 1440}, 0, 0).height == 1440);
+}
