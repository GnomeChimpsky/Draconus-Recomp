index b46d2cc..9e5e731 100644
--- a/render/tests/test_input.cpp
+++ b/render/tests/test_input.cpp
@@ -109,3 +109,39 @@ TEST_CASE("a silly dead zone is clamped, not obeyed") {
     CHECK(Bindings::from_text("deadzone = 5000\n").deadzone_percent == 90);
     CHECK(Bindings::from_text("deadzone = -3\n").deadzone_percent == 0);
 }
+
+TEST_CASE("modern controls change only the gamepad sticks, triggers and the A/X extras") {
+    const Bindings base = Bindings::defaults();
+
+    const EffectiveBindings classic = effective_bindings(base, InputPreset::Classic);
+    for (unsigned i = 0; i < kPadControlCount; ++i) {
+        const auto c = static_cast<PadControl>(i);
+        CHECK(classic.gamepad[c] == base.gamepad[c]);
+        CHECK(classic.keyboard[c] == base.keyboard[c]);
+    }
+    CHECK(classic.extra_gamepad.empty());
+
+    const EffectiveBindings modern = effective_bindings(base, InputPreset::Modern);
+    // The left stick's horizontal half drives strafing, the right stick's drives turning, and the
+    // left stick's vertical half stays forward/back.
+    CHECK(modern.gamepad[PadControl::LeftTrigger].text() == "axis:leftx-");
+    CHECK(modern.gamepad[PadControl::RightTrigger].text() == "axis:leftx+");
+    CHECK(modern.gamepad[PadControl::StickLeft].text() == "axis:rightx-");
+    CHECK(modern.gamepad[PadControl::StickRight].text() == "axis:rightx+");
+    CHECK(modern.gamepad[PadControl::StickUp].text() == "axis:lefty-");
+    CHECK(modern.gamepad[PadControl::StickDown].text() == "axis:lefty+");
+    // A and X keep their own bindings; the triggers join them rather than replacing them.
+    CHECK(modern.gamepad[PadControl::A] == base.gamepad[PadControl::A]);
+    CHECK(modern.gamepad[PadControl::X] == base.gamepad[PadControl::X]);
+    CHECK(modern.gamepad[PadControl::B] == base.gamepad[PadControl::B]);
+    REQUIRE(modern.extra_gamepad.size() == 2);
+    CHECK(modern.extra_gamepad[0].control == PadControl::A);
+    CHECK(modern.extra_gamepad[0].binding.text() == "axis:lefttrigger+");
+    CHECK(modern.extra_gamepad[1].control == PadControl::X);
+    CHECK(modern.extra_gamepad[1].binding.text() == "axis:righttrigger+");
+    // The keyboard is not part of the pad preset.
+    for (unsigned i = 0; i < kPadControlCount; ++i) {
+        const auto c = static_cast<PadControl>(i);
+        CHECK(modern.keyboard[c] == base.keyboard[c]);
+    }
+}
