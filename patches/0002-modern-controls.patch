+// How the title is played. Classic is the Dreamcast pad layout; Modern is the optional twin-stick
+// layout: left stick strafes and moves, right stick turns, the left trigger blocks and the right
+// trigger attacks. The preset is a layer over the player's own bindings, not a separate file, so F1
+// keeps editing the player's layout and switching presets does not lose it.
+enum class InputPreset : unsigned { Classic, Modern };
+
+// A second physical source for one guest control. The binding model otherwise has exactly one
+// source per control, which is why Modern needs this: A must stay on the A button *and* answer the
+// left trigger, and X must stay on the X button *and* answer the right trigger.
+struct ExtraBinding {
+    PadControl control = PadControl::Count;
+    Binding binding;
+};
+
+// What the window resolves for a poll. `gamepad` is the player's set after the preset's overrides;
+// `extra_gamepad` holds the controls that answer to a second physical input.
+struct EffectiveBindings {
+    DeviceBindings keyboard;
+    DeviceBindings gamepad;
+    std::vector<ExtraBinding> extra_gamepad;
+};
+
+// Classic returns the player's sets untouched. Modern overrides only the gamepad stick and trigger
+// controls and adds the A/X extras; every other control, and the whole keyboard set, is left alone.
+EffectiveBindings effective_bindings(const Bindings& base, InputPreset preset);
+
 }  // namespace dream::render
