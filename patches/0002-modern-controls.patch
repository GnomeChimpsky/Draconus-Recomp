+EffectiveBindings effective_bindings(const Bindings& base, InputPreset preset) {
+    EffectiveBindings out{base.keyboard, base.gamepad, {}};
+    if (preset != InputPreset::Modern)
+        return out;
+    auto axis = [](const char* name, int sign) { return Binding{BindSource::Axis, name, sign}; };
+    // The game's own movement is tank-like: stick Y is forward/back, stick X turns, and the
+    // triggers strafe. Modern moves the horizontal halves apart: the left stick's X drives the
+    // strafe triggers, the right stick's X drives the turn, and the left stick's Y stays forward
+    // and back. The right trigger is the attack button's second source, not a trigger any more.
+    out.gamepad[PadControl::LeftTrigger] = axis("leftx", -1);
+    out.gamepad[PadControl::RightTrigger] = axis("leftx", 1);
+    out.gamepad[PadControl::StickLeft] = axis("rightx", -1);
+    out.gamepad[PadControl::StickRight] = axis("rightx", 1);
+    out.gamepad[PadControl::StickUp] = axis("lefty", -1);
+    out.gamepad[PadControl::StickDown] = axis("lefty", 1);
+    out.extra_gamepad.push_back({PadControl::A, axis("lefttrigger", 1)});
+    out.extra_gamepad.push_back({PadControl::X, axis("righttrigger", 1)});
+    return out;
+}
