+namespace {
+// Resume entries in flight. A fragment and the root function it belongs to can both contain an
+// address, and the nearest one may not know it: Draconus branches to the case labels of a `mov.w`
+// switch from a fragment at 0x0C234F1C, while only the wider function at 0x0C234E7E has those
+// labels in its resume switch. The runtime tries the next containing entry before giving up, but
+// never the same one twice, so a genuine miss still reaches the interpreter.
+thread_local const FunctionEntry* t_resume_tried[16];
+thread_local int t_resume_depth = 0;
+
+void call_resume(Ctx& c, ::dream::Memory& m, std::uint32_t pc, const FunctionEntry* e) {
+    if (t_resume_depth < 16)
+        t_resume_tried[t_resume_depth] = e;
+    ++t_resume_depth;
+    e->resume(c, m, pc);
+    --t_resume_depth;
+}
+
+bool resume_tried(const FunctionEntry* e) {
+    for (int i = 0; i < t_resume_depth && i < 16; ++i)
+        if (t_resume_tried[i] == e)
+            return true;
+    return false;
+}
