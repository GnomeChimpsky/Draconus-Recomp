+// Appends one strip to a frame: x..x+10 across, 10..90 down, at a fixed depth. `tcw` is the texture
+// address, which is what tells two strips of the same art apart; `u0`/`u1` are its texture
+// coordinates, which is what identifies a strip when the list order changes.
+Polygon add_strip(Frame& frame, float x, std::uint32_t tcw = 0x33333333u, float u0 = 0.0f,
+                  float u1 = 1.0f, float y = 10.0f) {
+    Polygon polygon;
+    polygon.first = static_cast<std::uint32_t>(frame.vertices.size());
+    polygon.count = 3;
+    polygon.pcw = 0x12345678u;
+    polygon.isp = 0x00000011u;
+    polygon.tsp = 0x22222222u;
+    polygon.tcw = tcw;
+    frame.vertices.push_back(vertex(x, y, 0.5f, u0, 0.0f));
+    frame.vertices.push_back(vertex(x + 10.0f, y, 0.5f, u1, 0.0f));
+    frame.vertices.push_back(vertex(x, y + 80.0f, 0.5f, u0, 1.0f));
+    frame.lists[0].push_back(polygon);
+    ++frame.strips;
+    frame.min_z = frame.max_z = 0.5f;
+    return polygon;
+}
