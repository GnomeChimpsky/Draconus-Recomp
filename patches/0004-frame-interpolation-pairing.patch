+#version 450
+// The colour the vertex carries, blended over the picture by the pipeline's blend state. Straight
+// alpha, which is what the counter's translucent panel and opaque glyphs are written as.
+layout(push_constant) uniform Push {
+    vec2 scale;
+    vec2 offset;
+    vec2 texel;
+    vec2 taps;
+} push;
+
+layout(location = 0) in vec4 v_colour;
+
+layout(location = 0) out vec4 out_colour;
+
+void main() {
+    out_colour = v_colour;
+}
diff --git b/render/shaders/overlay.vert b/render/shaders/overlay.vert
new file mode 100644
index 0000000..fe3e8b7
--- /dev/null
+++ b/render/shaders/overlay.vert
@@ -0,0 +1,27 @@
+#version 450
+// Solid rectangles in the image's own pixel space: the on-screen counter. Its font is a grid of
+// filled squares, so text needs no texture and no host copy of the frame -- which is what it used to
+// need, at 20 MB down and 20 MB up per present at 4x.
+//
+// The push block is the one present.vert uses, so a rectangle lands exactly over the picture pixel
+// it covers whatever the window shape, letterbox or content aspect does to the image. `texel` is
+// the image's size, which is what turns image pixels into the unit square.
+layout(push_constant) uniform Push {
+    vec2 scale;
+    vec2 offset;
+    vec2 texel;
+    vec2 taps;
+} push;
+
+layout(location = 0) in vec2 in_pos;
+layout(location = 1) in vec4 in_colour;
+
+layout(location = 0) out vec4 v_colour;
+
+void main() {
+    // The image's top-left corner is the clip-space corner present.vert puts there: v_uv 0 is NDC -1
+    // on both axes, and Vulkan's clip space has +y downwards, so image row 0 is -1.
+    const vec2 uv = in_pos * push.texel;
+    gl_Position = vec4((uv * 2.0 - 1.0) * push.scale + push.offset, 0.0, 1.0);
+    v_colour = in_colour;
+}
