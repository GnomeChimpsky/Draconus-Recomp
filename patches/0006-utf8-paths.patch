+// Windows hands the process UTF-16 arguments. Convert them once to UTF-8, which is what SDL and
+// the launcher use, so --config/--disc/--vmu and every debug output path survive non-ASCII names.
+#if defined(_WIN32)
+int wmain(int argc, wchar_t** wargv) {
+    std::vector<std::string> args;
+    args.reserve(static_cast<std::size_t>(argc));
+    for (int i = 0; i < argc; ++i) {
+        const int size =
+            WideCharToMultiByte(CP_UTF8, 0, wargv[i], -1, nullptr, 0, nullptr, nullptr);
+        if (size <= 0)
+            return 2;
+        std::vector<char> buf(static_cast<std::size_t>(size));
+        WideCharToMultiByte(CP_UTF8, 0, wargv[i], -1, buf.data(), size, nullptr, nullptr);
+        args.emplace_back(buf.data(), static_cast<std::size_t>(size - 1));
+    }
+    std::vector<char*> argv;
+    argv.reserve(args.size());
+    for (auto& arg : args)
+        argv.push_back(arg.data());
+    return run(static_cast<int>(argv.size()), argv.data());
+}
+#else
+int main(int argc, char** argv) { return run(argc, argv); }
+#endif
