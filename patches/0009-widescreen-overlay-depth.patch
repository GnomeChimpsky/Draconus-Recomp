+    // The old key was the nearest corner, and the floor's (0.269) is nearer than the skirt's
+    // (0.2678), which is exactly what drew the bars over the skirt.
+    CHECK(frame.vertices[1].z > frame.vertices[4].z);
+
+    Polygon empty;  // a polygon pointing past the vertices has no depth
+    empty.first = 99;
+    empty.count = 3;
+    CHECK(polygon_sort_depth(frame, empty) == doctest::Approx(0.0f));
 }
