diff --git a/render/tests/test_display_list.cpp b/render/tests/test_display_list.cpp
index 8c9d61e..1d5c051 100644
--- a/render/tests/test_display_list.cpp
+++ b/render/tests/test_display_list.cpp
@@ -841,6 +841,79 @@ TEST_CASE("widescreen carries a HUD panel's 3D model with the panel") {
 // the rocks' glow came apart and snapped back as each shaft crossed the 128-pixel size test. A
 // panel is drawn at the HUD's depth, at or just behind the near plane, so a quad far behind that
 // plane is scenery and must stay with the world.
+// A FOV change zooms the item model inside the wheel but not the screen-space panel. The model is
+// scaled back about the panel's centre; its submission after the panel identifies it even when a
+// narrow FOV puts its 1/w below the panel's own depth, while world geometry behind the wheel was
+// submitted before the panel and stays with the world.
+TEST_CASE("a field-of-view change keeps the item model inside its panel") {
+    Frame frame;
+    auto quad = [&](float x0, float y0, float x1, float y1, float z, int list) {
+        Polygon p;
+        p.first = static_cast<u32>(frame.vertices.size());
+        p.count = 4;
+        const float xs[4] = {x0, x1, x0, x1};
+        const float ys[4] = {y0, y0, y1, y1};
+        for (int i = 0; i < 4; ++i) {
+            Vertex v;
+            v.x = xs[i];
+            v.y = ys[i];
+            v.z = z;
+            frame.vertices.push_back(v);
+        }
+        frame.lists[list].push_back(p);
+        return p.first;
+    };
+    // The world's near plane is z = 2.0; the wheel panel is at z = 1.0.
+    const u32 world = quad(400, 400, 420, 420, 0.5f, 0);
+    frame.vertices[world + 1].z = 2.0f;
+    // A world polygon behind the wheel, submitted before the panel.
+    Polygon behind;
+    behind.first = static_cast<u32>(frame.vertices.size());
+    behind.count = 3;
+    const float bx[3] = {100, 150, 120}, by[3] = {350, 350, 400};
+    for (int i = 0; i < 3; ++i) {
+        Vertex v;
+        v.x = bx[i];
+        v.y = by[i];
+        v.z = 0.5f;
+        frame.vertices.push_back(v);
+    }
+    frame.lists[0].push_back(behind);
+    const u32 behind_first = behind.first;
+    const u32 panel = quad(1, 305, 257, 561, 1.0f, 2);
+    // The item model, submitted after the panel and *below* its depth: a narrow FOV moves the
+    // model's 1/w down, and submission order is what still says it belongs to the panel.
+    Polygon model;
+    model.first = static_cast<u32>(frame.vertices.size());
+    model.count = 3;
+    const float mx[3] = {100, 150, 120}, my[3] = {350, 350, 400};
+    for (int i = 0; i < 3; ++i) {
+        Vertex v;
+        v.x = mx[i];
+        v.y = my[i];
+        v.z = 0.5f;
+        frame.vertices.push_back(v);
+    }
+    frame.lists[2].push_back(model);
+    const u32 model_first = model.first;
+
+    CHECK(compress_screen_overlays(frame, 1.0f, 640.0f, 1.3f) == 1);
+    // The panel is screen-space art and does not move.
+    CHECK(frame.vertices[panel].x == doctest::Approx(1.0f));
+    CHECK(frame.vertices[panel + 3].y == doctest::Approx(561.0f));
+    // The model shrinks about the panel's centre (129, 433) by 1/1.3.
+    CHECK(frame.vertices[model_first].x == doctest::Approx(106.6923f));
+    CHECK(frame.vertices[model_first + 1].x == doctest::Approx(145.1538f));
+    CHECK(frame.vertices[model_first].y == doctest::Approx(369.1538f));
+    CHECK(frame.vertices[model_first + 2].y == doctest::Approx(407.6154f));
+    // It is also brought just in front of the panel so the ring cannot cover it.
+    CHECK(frame.vertices[model_first].z == doctest::Approx(1.1f));
+    // The world behind it, submitted before the panel, is untouched.
+    CHECK(frame.vertices[behind_first].x == doctest::Approx(100.0f));
+    CHECK(frame.vertices[behind_first].y == doctest::Approx(350.0f));
+    CHECK(frame.vertices[behind_first].z == doctest::Approx(0.5f));
+}
