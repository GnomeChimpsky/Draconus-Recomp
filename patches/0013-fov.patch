+TEST_CASE("game config: the camera FOV hook is optional and validated") {
+    GameConfig c;
+    std::string err;
+    // A title with no camera block keeps the default and has no hook.
+    REQUIRE_MESSAGE(parse_game_config(kSample, ".", c, err), err);
+    CHECK(c.fov_address == 0u);
+    CHECK(c.fov_base_degrees == 90.0);
+
+    REQUIRE_MESSAGE(parse_game_config(R"(
+[game]
+id = "x"
+title = "X"
+[binary]
+path = "x.bin"
+load_address = 0x8C010000
+entry = 0x8C010000
+[camera]
+fov_address = 0x0C098648
+fov_base_degrees = 75.0
+)",
+                                      ".", c, err),
+                    err);
+    CHECK(c.fov_address == 0x0C098648u);
+    CHECK(c.fov_base_degrees == 75.0);
+
+    // An integer is accepted where a TOML float would be written.
+    REQUIRE_MESSAGE(parse_game_config(R"(
+[game]
+id = "x"
+title = "X"
+[binary]
+path = "x.bin"
+load_address = 0x8C010000
+entry = 0x8C010000
+[camera]
+fov_address = 0x0C098648
+fov_base_degrees = 90
+)",
+                                      ".", c, err),
+                    err);
+    CHECK(c.fov_base_degrees == 90.0);
+
+    // A bad angle names the field.
+    CHECK(!parse_game_config(R"(
+[game]
+id = "x"
+title = "X"
+[binary]
+path = "x.bin"
+load_address = 0x8C010000
+entry = 0x8C010000
+[camera]
+fov_address = 0x0C098648
+fov_base_degrees = 180.0
+)",
+                             ".", c, err));
+    CHECK(err.find("camera.fov_base_degrees") != std::string::npos);
+
+    // A misaligned address would write a float over the neighbouring word.
+    CHECK(!parse_game_config(R"(
+[game]
+id = "x"
+title = "X"
+[binary]
+path = "x.bin"
+load_address = 0x8C010000
+entry = 0x8C010000
+[camera]
+fov_address = 0x0C098649
+)",
+                             ".", c, err));
+    CHECK(err.find("4-byte aligned") != std::string::npos);
