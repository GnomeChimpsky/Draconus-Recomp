diff --git b/render/tests/test_camera_look.cpp b/render/tests/test_camera_look.cpp
new file mode 100644
index 0000000..26dd8b9
--- /dev/null
+++ b/render/tests/test_camera_look.cpp
@@ -0,0 +1,76 @@
+#include "dream/render/camera_look.h"
+
+#include <cmath>
+
+#include "doctest.h"
+
+using dream::render::apply_camera_pitch;
+using dream::render::Frame;
+using dream::render::Polygon;
+using dream::render::Vertex;
+
+namespace {
+
+Polygon add_polygon(Frame& frame, int list, std::initializer_list<Vertex> vertices) {
+    Polygon p;
+    p.first = static_cast<std::uint32_t>(frame.vertices.size());
+    p.count = static_cast<std::uint32_t>(vertices.size());
+    frame.vertices.insert(frame.vertices.end(), vertices.begin(), vertices.end());
+    frame.lists[static_cast<std::size_t>(list)].push_back(p);
+    return p;
+}
+
+}  // namespace
+
+TEST_CASE("camera look: a pitched 3D vertex keeps its ray and moves the picture") {
+    Frame frame;
+    // One triangle with a depth span, so it is part of the 3D view. The centre vertex is on the
+    // screen centre at 1/w = 0.5.
+    add_polygon(frame, 0, {{300, 200, 0.5f}, {320, 240, 0.5f}, {340, 200, 1.0f}});
+    const float pitch = 0.25f;  // positive looks down
+    CHECK(apply_camera_pitch(frame, pitch, 0.75f, 1.0f, 640.0f, 480.0f) == 1);
+    // The centre ray (0, 0, 1) pitches to (0, -sin, cos), so the centre vertex moves down less
+    // than a pixel? It stays at the centre x; y = 240 + (-sin/cos)*240.
+    CHECK(frame.vertices[1].x == doctest::Approx(320.0f));
+    CHECK(frame.vertices[1].y == doctest::Approx(240.0f - std::tan(pitch) * 240.0f));
+    CHECK(frame.vertices[1].z == doctest::Approx(0.5f / std::cos(pitch)));
+}
+
+TEST_CASE("camera look: screen-space quads and HUD panel contents stay on the glass") {
+    Frame frame;
+    // The world has depth, so the frame is 3D.
+    add_polygon(frame, 0, {{100, 100, 0.5f}, {200, 100, 0.5f}, {100, 200, 2.0f}});
+    // A screen-space HUD quad: one depth, no span.
+    const Polygon hud = add_polygon(frame, 2, {{10, 10, 9.0f}, {30, 10, 9.0f},
+                                               {10, 30, 9.0f}, {30, 30, 9.0f}});
+    // The item wheel: a 256x256 panel at the HUD depth, and its projected model just in front of
+    // it, submitted after the panel.
+    const Polygon panel = add_polygon(frame, 2, {{1, 305, 1.0f}, {257, 305, 1.0f},
+                                                 {1, 561, 1.0f}, {257, 561, 1.0f}});
+    const Polygon model = add_polygon(frame, 2, {{100, 350, 1.1f}, {150, 350, 1.2f},
+                                                 {120, 400, 1.3f}});
+    const float model_x = frame.vertices[model.first].x;
+    const float model_y = frame.vertices[model.first].y;
+    const float model_z = frame.vertices[model.first].z;
+    CHECK(apply_camera_pitch(frame, 0.3f, 0.75f, 1.0f, 640.0f, 480.0f) == 1);
+    for (std::uint32_t i = 0; i < hud.count; ++i) {
+        CHECK(frame.vertices[hud.first + i].x == doctest::Approx(10.0f + (i % 2) * 20.0f));
+        CHECK(frame.vertices[hud.first + i].z == doctest::Approx(9.0f));
+    }
+    for (std::uint32_t i = 0; i < model.count; ++i) {
+        CHECK(frame.vertices[model.first + i].x ==
+              doctest::Approx(i == 1 ? 150.0f : (i == 2 ? 120.0f : 100.0f)));
+        CHECK(frame.vertices[model.first + i].z ==
+              doctest::Approx(i == 1 ? 1.2f : (i == 2 ? 1.3f : 1.1f)));
+    }
+    CHECK(frame.vertices[model.first].y == doctest::Approx(model_y));
+    CHECK(frame.vertices[panel.first].x == doctest::Approx(1.0f));
+    CHECK(frame.vertices[model.first].x == doctest::Approx(model_x));
+    CHECK(frame.vertices[model.first].z == doctest::Approx(model_z));
+}
+
+TEST_CASE("camera look: zero pitch leaves the frame alone") {
+    Frame frame;
+    add_polygon(frame, 0, {{100, 100, 0.5f}, {200, 100, 0.5f}, {100, 200, 2.0f}});
+    CHECK(apply_camera_pitch(frame, 0.0f, 0.75f, 1.0f, 640.0f, 480.0f) == 0);
+}
