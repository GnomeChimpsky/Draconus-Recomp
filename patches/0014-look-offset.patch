diff --git b/render/include/dream/render/camera_look.h b/render/include/dream/render/camera_look.h
new file mode 100644
index 0000000..00f2d69
--- /dev/null
+++ b/render/include/dream/render/camera_look.h
@@ -0,0 +1,33 @@
+// Camera look up/down without touching the title's camera.
+//
+// The PVR receives vertices already projected to screen space. A true camera pitch is still
+// recoverable from them: screen x/y and 1/w give the camera-space ray, a rotation about the
+// camera's horizontal axis pitches it, and the same projection maps it back. The title's own
+// camera, collision and visibility do not change; the HUD is left on the glass.
+//
+// This is a port feature: the title has no player-facing pitch input, and the chase camera takes
+// only yaw from the stick. Applying the offset after projection keeps the game logic (movement,
+// culling, cutscene cameras) exactly as it was.
+#pragma once
+
+#include <cstddef>
+
+#include "dream/render/display_list.h"
+
+namespace dream::render {
+
+// Rotate the 3D content of `frame` about the camera's horizontal axis by `pitch` radians. Positive
+// pitch looks down, negative looks up (the caller's stick sign decides).
+//
+// `ndc_x_scale` and `ndc_y_scale` are the projection matrix's x and y scales: 0.75 and 1.0 for the
+// title's 4:3 90-degree view, multiplied by the FOV factor and, for x, by the widescreen aspect.
+// `width` and `height` are the guest's 640x480 screen, which is the space the vertices use.
+//
+// Screen-space quads (the HUD, text, fades) have no depth span and stay where they are. A HUD
+// panel's projected 3D contents (the item wheel's model) are also left alone: the wheel is pinned
+// to a screen-space panel, so pitching it would slide the item out of its ring. Everything else
+// with depth is transformed. Returns how many polygons moved.
+std::size_t apply_camera_pitch(Frame& frame, float pitch, float ndc_x_scale,
+                               float ndc_y_scale, float width, float height);
+
+}  // namespace dream::render
