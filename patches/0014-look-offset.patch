 }
 
+float Window::right_stick_y() const noexcept {
+    for (SDL_Gamepad* g : pads_) {
+        if (!g)
+            continue;
+        // SDL's convention: the top of the stick is negative. The camera look uses that directly;
+        // the caller decides whether up means look up or down.
+        return static_cast<float>(SDL_GetGamepadAxis(g, SDL_GAMEPAD_AXIS_RIGHTY)) / 32767.0f;
+    }
+#if defined(_WIN32)
+    // The same fallback the rest of the input uses. XInput's Y is positive up, the opposite of
+    // SDL's, so negate it to keep one convention.
+    XInputState st{};
+    if (poll_xinput(st))
+        return -static_cast<float>(st.pad.thumb_ry) / 32767.0f;
+#endif
+    return 0.0f;
+}
