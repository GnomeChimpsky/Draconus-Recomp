diff --git b/render/src/camera_look.cpp b/render/src/camera_look.cpp
new file mode 100644
index 0000000..ef8201b
--- /dev/null
+++ b/render/src/camera_look.cpp
@@ -0,0 +1,180 @@
+// See camera_look.h.
+#include "dream/render/camera_look.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <unordered_set>
+#include <vector>
+
+namespace dream::render {
+namespace {
+
+struct Bounds {
+    float lo = 0, hi = 0, min_x = 0, max_x = 0, min_y = 0, max_y = 0;
+    bool ok = false;
+};
+
+Bounds polygon_bounds(const Frame& frame, const Polygon& polygon) {
+    Bounds b;
+    const std::size_t first = polygon.first;
+    const std::size_t last = std::min(frame.vertices.size(), first + polygon.count);
+    if (first >= last || last - first < 2)
+        return b;
+    b.lo = b.hi = frame.vertices[first].z;
+    b.min_x = b.max_x = frame.vertices[first].x;
+    b.min_y = b.max_y = frame.vertices[first].y;
+    for (std::size_t i = first + 1; i < last; ++i) {
+        const Vertex& v = frame.vertices[i];
+        b.lo = std::min(b.lo, v.z);
+        b.hi = std::max(b.hi, v.z);
+        b.min_x = std::min(b.min_x, v.x);
+        b.max_x = std::max(b.max_x, v.x);
+        b.min_y = std::min(b.min_y, v.y);
+        b.max_y = std::max(b.max_y, v.y);
+    }
+    b.ok = true;
+    return b;
+}
+
+// The HUD panel heuristic, kept in step with compress_screen_overlays: a large flat four-vertex
+// quad at the HUD's depth. Its projected 3D contents are the item wheel's model, which must not be
+// pitched with the world.
+struct Panel {
+    float z = 0, min_x = 0, max_x = 0, min_y = 0, max_y = 0;
+    Polygon* quad = nullptr;
+    unsigned list = 0;
+    std::size_t order = 0;
+};
+
+std::unordered_set<const Polygon*> hud_panel_contents(Frame& frame, float width) {
+    constexpr float kRelative = 1e-5f;
+    std::unordered_set<const Polygon*> marked;
+    float world_z = -std::numeric_limits<float>::infinity();
+    for (const auto& list : frame.lists) {
+        for (const Polygon& polygon : list) {
+            const Bounds b = polygon_bounds(frame, polygon);
+            if (!b.ok)
+                continue;
+            const float scale = std::max(1.0f, std::max(std::fabs(b.lo), std::fabs(b.hi)));
+            if (b.hi - b.lo > kRelative * scale)
+                world_z = std::max(world_z, b.hi);
+        }
+    }
+    if (!std::isfinite(world_z))
+        return marked;
+    const float panel_min_z = world_z * 0.5f;
+    const float panel_max_z = world_z * 4.0f;
+
+    std::vector<Panel> panels;
+    for (unsigned li = 0; li < kListCount; ++li) {
+        auto& list = frame.lists[li];
+        for (std::size_t pi = 0; pi < list.size(); ++pi) {
+            Polygon& polygon = list[pi];
+            if (polygon.count != 4)
+                continue;
+            const Bounds b = polygon_bounds(frame, polygon);
+            if (!b.ok)
+                continue;
+            const float scale = std::max(1.0f, std::max(std::fabs(b.lo), std::fabs(b.hi)));
+            if (b.hi - b.lo > kRelative * scale)
+                continue;
+            if (b.lo < panel_min_z || b.lo > panel_max_z)
+                continue;
+            const float w = b.max_x - b.min_x, h = b.max_y - b.min_y;
+            if (w < 128.0f || h < 128.0f || w > width * 0.9f)
+                continue;
+            panels.push_back(Panel{b.lo, b.min_x, b.max_x, b.min_y, b.max_y, &polygon, li, pi});
+        }
+    }
+
+    for (const Panel& panel : panels) {
+        for (unsigned li = 0; li < kListCount; ++li) {
+            auto& list = frame.lists[li];
+            for (std::size_t pi = 0; pi < list.size(); ++pi) {
+                Polygon& polygon = list[pi];
+                const bool is_panel = &polygon == panel.quad;
+                if (!is_panel && (li < panel.list || (li == panel.list && pi <= panel.order)))
+                    continue;
+                if (is_panel)
+                    continue;
+                const Bounds b = polygon_bounds(frame, polygon);
+                if (!b.ok)
+                    continue;
+                if (b.min_x < panel.min_x - 1.0f || b.max_x > panel.max_x + 1.0f ||
+                    b.min_y < panel.min_y - 1.0f || b.max_y > panel.max_y + 1.0f)
+                    continue;
+                // The wheel's model may be in front of or behind the panel's 1/w, depending on the
+                // item and the FOV; the panel is screen-space art either way.
+                if (b.lo < panel.z - 1.5f || b.hi > panel.z + 1.5f)
+                    continue;
+                marked.insert(&polygon);
+            }
+        }
+    }
+    return marked;
+}
+
+}  // namespace
+
+std::size_t apply_camera_pitch(Frame& frame, float pitch, float ndc_x_scale,
+                               float ndc_y_scale, float width, float height) {
+    if (!(width > 0.0f) || !(height > 0.0f) || !(ndc_x_scale > 0.0f) ||
+        !(ndc_y_scale > 0.0f) || std::fabs(pitch) < 1e-6f)
+        return 0;
+
+    const auto hud = hud_panel_contents(frame, width);
+    const float cx = width * 0.5f;
+    const float cy = height * 0.5f;
+    const float c = std::cos(pitch);
+    const float s = std::sin(pitch);
+    std::size_t moved = 0;
+    for (unsigned li = 0; li < kListCount; ++li) {
+        for (Polygon& polygon : frame.lists[li]) {
+            if (hud.count(&polygon))
+                continue;
+            const Bounds b = polygon_bounds(frame, polygon);
+            if (!b.ok)
+                continue;
+            const float scale = std::max(1.0f, std::max(std::fabs(b.lo), std::fabs(b.hi)));
+            // A screen-space quad has one depth and is not part of the 3D view: the HUD, text,
+            // fades and the background plane all live there and stay put.
+            if (b.hi - b.lo <= 1e-5f * scale)
+                continue;
+            const std::size_t first = polygon.first;
+            const std::size_t last = std::min(frame.vertices.size(), first + polygon.count);
+            for (std::size_t i = first; i < last; ++i) {
+                Vertex& v = frame.vertices[i];
+                // Screen x/y and 1/w give the camera-space ray: (dx, dy, 1). Rotate it about the
+                // camera's horizontal axis, then project it with the same scales.
+                const float dx = (v.x - cx) / (ndc_x_scale * cx);
+                const float dy = (v.y - cy) / (ndc_y_scale * cy);
+                const float dy2 = dy * c - s;
+                float dz2 = dy * s + c;
+                if (dz2 < 1e-4f)
+                    dz2 = 1e-4f;
+                v.x = cx + (dx / dz2) * ndc_x_scale * cx;
+                v.y = cy + (dy2 / dz2) * ndc_y_scale * cy;
+                v.z /= dz2;
+            }
+            ++moved;
+        }
+    }
+    if (!moved)
+        return 0;
+
+    // The pitched frame's depth range can move; keep the diagnostics and any depth policy that
+    // reads it honest.
+    float lo = std::numeric_limits<float>::infinity(), hi = -std::numeric_limits<float>::infinity();
+    for (const Vertex& v : frame.vertices) {
+        lo = std::min(lo, v.z);
+        hi = std::max(hi, v.z);
+    }
+    if (std::isfinite(lo) && std::isfinite(hi)) {
+        frame.min_z = lo;
+        frame.max_z = hi;
+    }
+    return moved;
+}
+
+}  // namespace dream::render
