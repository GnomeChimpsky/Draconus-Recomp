+// A hardware check for the Controller tab, with no game attached.
+//
+//   dream_haptics_probe [--speaker] [--seconds N]
+//
+// Opens the first pad, hands it to RenHDrum and plays a short scripted sequence: a held block that
+// resists, a block that takes a hit, a swing that lands, and a burst of plain rumble. It prints what
+// it claimed and what it played, so "haptics are on but nothing happens" can be told apart from "the
+// pad was never claimed" without starting a game and playing to the first fight.
+//
+// Exit codes: 0 the sequence ran, 2 no pad, 3 no renhdrum.dll.
+#include <SDL3/SDL.h>
+
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <thread>
+
+#include "dream/render/haptics.h"
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+// The script, in seconds since start. One line per moment so the console reads like the sequence a
+// player would recognise.
+struct Step {
+    double at;
+    const char* what;
+};
+
+constexpr Step kScript[] = {
+    {0.60, "block down: the left trigger should resist from about a third of its travel"},
+    {1.80, "block takes a hit: a short buzz in the left trigger"},
+    {2.80, "block release: the trigger goes free"},
+    {3.60, "attack press: a faint buzz in the right trigger"},
+    {4.10, "attack lands: a harder buzz in the right trigger"},
+    {5.20, "plain rumble: the pad's actuators, both sides"},
+    {6.80, "stop"},
+};
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    bool speaker = false;
+    double seconds = 8.0;
+    for (int i = 1; i < argc; ++i) {
+        if (std::strcmp(argv[i], "--speaker") == 0) {
+            speaker = true;
+        } else if (std::strcmp(argv[i], "--seconds") == 0 && i + 1 < argc) {
+            seconds = std::atof(argv[++i]);
+        } else if (std::strcmp(argv[i], "--help") == 0) {
+            std::printf("usage: %s [--speaker] [--seconds N]\n", argv[0]);
+            return 0;
+        }
+    }
+
+    if (!SDL_Init(SDL_INIT_GAMEPAD)) {
+        std::fprintf(stderr, "SDL_Init(gamepad): %s\n", SDL_GetError());
+        return 2;
+    }
+    SDL_InitSubSystem(SDL_INIT_AUDIO);
+
+    dream::render::HapticsOptions options;
+    options.hd_rumble = true;
+    options.trigger_feedback = true;
+    options.trigger_resistance = true;
+    options.speaker = speaker;
+
+    dream::render::Haptics haptics;
+    haptics.configure(options);
+    std::printf("%s\n", haptics.status().c_str());
+    if (haptics.status().find("renhdrum.dll") != std::string::npos) {
+        std::fprintf(stderr, "renhdrum.dll must sit beside this executable\n");
+        return 3;
+    }
+
+    // Match the window: every pad it could drive is opened, and only the first is scripted.
+    int count = 0;
+    SDL_JoystickID* ids = SDL_GetGamepads(&count);
+    SDL_Gamepad* pad = nullptr;
+    if (ids) {
+        for (int i = 0; i < count && !pad; ++i)
+            pad = SDL_OpenGamepad(ids[i]);
+        SDL_free(ids);
+    }
+    if (!pad) {
+        std::fprintf(stderr, "no gamepad found\n");
+        return 2;
+    }
+    const char* name = SDL_GetGamepadName(pad);
+    std::printf("pad: %s (vid %04X pid %04X)\n", name && *name ? name : "?",
+                SDL_GetGamepadVendor(pad), SDL_GetGamepadProduct(pad));
+    haptics.attach(pad);
+    std::printf("%s\n", haptics.status().c_str());
+    if (!haptics.claims(pad)) {
+        std::printf("this pad was not claimed for rumble: %s\n",
+                    "it keeps SDL's own rumble (a wireless DualSense, or an unknown pad)");
+    }
+
+    const auto start = Clock::now();
+    auto elapsed = [&start] {
+        return std::chrono::duration<double>(Clock::now() - start).count();
+    };
+    std::size_t next_step = 0;
+    while (true) {
+        const double t = elapsed();
+        while (next_step < std::size(kScript) && t >= kScript[next_step].at) {
+            std::printf("%5.2f  %s\n", kScript[next_step].at, kScript[next_step].what);
+            const double at = kScript[next_step].at;
+            if (at > 0.55 && at < 0.65) {
+                // The block is held from here to 2.8 s; the planner owns the resistance.
+            } else if (at > 1.75 && at < 1.85) {
+                haptics.pack(dream::render::HapticsEffect{1.0f, 120, 26, false});
+            } else if (at > 4.05 && at < 4.15) {
+                haptics.pack(dream::render::HapticsEffect{1.0f, 100, 26, false});
+            } else if (at > 5.15 && at < 5.25) {
+                haptics.pack(dream::render::HapticsEffect{0.7f, 900, 15, true});
+            }
+            ++next_step;
+        }
+        if (t > seconds)
+            break;
+
+        const bool block = t >= 0.60 && t < 2.80;
+        const bool attack = t >= 3.60 && t < 5.00;
+        haptics.set_controls(block ? 1.0f : 0.0f, attack);
+        haptics.update();
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    }
+
+    haptics.stop();
+    SDL_CloseGamepad(pad);
+    SDL_Quit();
+    std::printf("done\n");
+    return 0;
+}
diff --git b/render/src/trigger_effect.cpp b/render/src/trigger_effect.cpp
new file mode 100644
index 0000000..c29353c
--- /dev/null
+++ b/render/src/trigger_effect.cpp
@@ -0,0 +1,180 @@
+// See trigger_effect.h. The byte layouts here are the DualSense zone effects: a mode byte, a 16-bit
+// map of which of the ten travel zones are active, and five 3-bit strengths packed into four bytes.
+#include "dream/render/trigger_effect.h"
+
+#include <algorithm>
+
+namespace dream::render {
+namespace {
+
+constexpr std::uint8_t kModeOff = 0x05;
+constexpr std::uint8_t kModeFeedback = 0x21;
+constexpr std::uint8_t kModeWeapon = 0x25;
+constexpr std::uint8_t kModeVibration = 0x26;
+
+int clamp_zone(int zone) {
+    return std::clamp(zone, 0, TriggerEffect::kZones - 1);
+}
+int clamp_strength(int strength) {
+    return std::clamp(strength, 1, 8);
+}
+
+// Packs per-zone strengths into the effect's active mask and strength words. A zone with a strength
+// of zero is simply not active, which is how a trigger stays free above or below the effect.
+void pack_zones(const int (&strengths)[TriggerEffect::kZones], TriggerEffect& out) {
+    std::uint16_t active = 0;
+    std::uint32_t values = 0;
+    for (int zone = 0; zone < TriggerEffect::kZones; ++zone) {
+        const int strength = strengths[zone];
+        if (strength <= 0)
+            continue;
+        active |= static_cast<std::uint16_t>(1u << zone);
+        values |= static_cast<std::uint32_t>((clamp_strength(strength) - 1) & 7) << (3 * zone);
+    }
+    out.bytes[1] = static_cast<std::uint8_t>(active & 0xFFu);
+    out.bytes[2] = static_cast<std::uint8_t>(active >> 8);
+    out.bytes[3] = static_cast<std::uint8_t>(values & 0xFFu);
+    out.bytes[4] = static_cast<std::uint8_t>((values >> 8) & 0xFFu);
+    out.bytes[5] = static_cast<std::uint8_t>((values >> 16) & 0xFFu);
+    out.bytes[6] = static_cast<std::uint8_t>((values >> 24) & 0xFFu);
+}
+
+}  // namespace
+
+bool operator==(const TriggerEffect& a, const TriggerEffect& b) noexcept {
+    for (std::size_t i = 0; i < TriggerEffect::kSize; ++i)
+        if (a.bytes[i] != b.bytes[i])
+            return false;
+    return true;
+}
+
+TriggerEffect trigger_off() {
+    TriggerEffect e{};
+    e.bytes[0] = kModeOff;
+    return e;
+}
+
+TriggerEffect trigger_feedback(int start_zone, int strength) {
+    int strengths[TriggerEffect::kZones]{};
+    for (int zone = clamp_zone(start_zone); zone < TriggerEffect::kZones; ++zone)
+        strengths[zone] = clamp_strength(strength);
+    TriggerEffect e{};
+    e.bytes[0] = kModeFeedback;
+    pack_zones(strengths, e);
+    return e;
+}
+
+TriggerEffect trigger_weapon(int start_zone, int end_zone, int strength) {
+    const int start = std::clamp(start_zone, 2, 7);
+    const int end = std::clamp(end_zone, start + 1, 8);
+    const auto zones = static_cast<std::uint16_t>((1u << start) | (1u << end));
+    TriggerEffect e{};
+    e.bytes[0] = kModeWeapon;
+    e.bytes[1] = static_cast<std::uint8_t>(zones & 0xFFu);
+    e.bytes[2] = static_cast<std::uint8_t>(zones >> 8);
+    e.bytes[3] = static_cast<std::uint8_t>(clamp_strength(strength) - 1);
+    return e;
+}
+
+TriggerEffect trigger_vibration(int start_zone, int amplitude, int frequency) {
+    int strengths[TriggerEffect::kZones]{};
+    for (int zone = clamp_zone(start_zone); zone < TriggerEffect::kZones; ++zone)
+        strengths[zone] = clamp_strength(amplitude);
+    TriggerEffect e{};
+    e.bytes[0] = kModeVibration;
+    pack_zones(strengths, e);
+    e.bytes[9] = static_cast<std::uint8_t>(std::clamp(frequency, 1, 255));
+    return e;
+}
+
+// ---- planner ------------------------------------------------------------------------------------
+
+void TriggerPlanner::set_block(bool held, double now) noexcept {
+    (void)now;
+    if (held == block_held_)
+        return;
+    block_held_ = held;
+    // Letting go ends the block-hit buzz with the block: a pulse that outlives the guard has nothing
+    // left to mean.
+    if (!held)
+        block_pulse_until_ = -1.0;
+}
+
+void TriggerPlanner::set_attack(bool held, double now) noexcept {
+    if (held == attack_held_)
+        return;
+    attack_held_ = held;
+    if (!held)
+        return;
+    // Every press swings. The faint buzz is the swing itself, and it also opens the window in which
+    // an incoming effect is read as *our* hit rather than as the game's ambience.
+    swing_window_until_ = now + kSwingWindow;
+    if (now - last_right_pulse_ >= kMinGap) {
+        swing_pulse_until_ = now + kSwingPulse;
+        last_right_pulse_ = now;
+    }
+}
+
+bool TriggerPlanner::impact(float power, double now) noexcept {
+    if (power < kImpactPower)
+        return false;
+    bool counted = false;
+    if (block_held_ && now - last_left_pulse_ >= kMinGap) {
+        block_pulse_until_ = now + kBlockPulse;
+        last_left_pulse_ = now;
+        counted = true;
+    }
+    if (now <= swing_window_until_ && now - last_right_pulse_ >= kMinGap) {
+        hit_pulse_until_ = now + kHitPulse;
+        last_right_pulse_ = now;
+        // One hit per swing: the burst that follows a landed blow is the same impact, not a second one.
+        swing_window_until_ = now;
+        counted = true;
+    }
+    return counted;
+}
+
+TriggerEffect TriggerPlanner::desired(TriggerSide side, double now) const noexcept {
+    if (side == TriggerSide::Left) {
+        if (now < block_pulse_until_)
+            return trigger_vibration(0, 8, 45);
+        if (block_held_ && feel_.resistance)
+            return trigger_feedback(feel_.resistance_zone, feel_.resistance_strength);
+        return trigger_off();
+    }
+    if (now < hit_pulse_until_)
+        return trigger_vibration(0, 8, 60);
+    if (now < swing_pulse_until_)
+        return trigger_vibration(0, 3, 30);
+    return trigger_off();
+}
+
+TriggerPlanner::Output TriggerPlanner::update(double now) {
+    Output out;
+    const TriggerEffect left = desired(TriggerSide::Left, now);
+    const TriggerEffect right = desired(TriggerSide::Right, now);
+    out.left.effect = left;
+    out.right.effect = right;
+    out.left.changed = !primed_ || left != sent_left_;
+    out.right.changed = !primed_ || right != sent_right_;
+    sent_left_ = left;
+    sent_right_ = right;
+    primed_ = true;
+    return out;
+}
+
+void TriggerPlanner::reset() noexcept {
+    block_held_ = false;
+    attack_held_ = false;
+    block_pulse_until_ = -1.0;
+    hit_pulse_until_ = -1.0;
+    swing_pulse_until_ = -1.0;
+    swing_window_until_ = -1.0;
+    last_left_pulse_ = -1.0;
+    last_right_pulse_ = -1.0;
+    sent_left_ = trigger_off();
+    sent_right_ = trigger_off();
+    primed_ = false;
+}
+
+}  // namespace dream::render
