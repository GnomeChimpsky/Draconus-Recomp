     int xinput_slot_ = -1;
diff --git b/render/src/haptics.cpp b/render/src/haptics.cpp
new file mode 100644
index 0000000..452a321
--- /dev/null
+++ b/render/src/haptics.cpp
@@ -0,0 +1,756 @@
+// See haptics.h. The host half of RenHDrum: one slot per claimed controller, the DLL resolved at run
+// time (never linked), and a fall-back to SDL's rumble on every path that cannot be taken.
+//
+// Threading: the window calls configure/attach/detach/pack/set_controls/update/stop from the game
+// thread. SDL calls the DualSense audio callback on its own thread, so a DSP handle is only touched
+// under that pad's dsp lock, and the handle is detached from the slot *before* the stream that feeds
+// it is destroyed -- the other order is a use-after-free the moment a callback is already in flight.
+#include "dream/render/haptics.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <SDL3/SDL.h>
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#endif
+
+#include "renhdrum.h"
+
+namespace dream::render {
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+constexpr int kAudioFrames = 256;
+constexpr int kChannels = 4;
+constexpr std::uint8_t kSpeakerPercent = RENHDRUM_HD_HAPTICS_SPEAKER_PERCENT;
+constexpr double kAudioRetrySeconds = 2.0;
+// The title sends one-shot effects and continuous ones, and a lost stop must still end. Half a second
+// of no repeat is long enough never to cut a real effect and short enough not to leave a motor on.
+constexpr double kIdleStopSeconds = 0.25;
+// The trigger is analogue; a pad that rests a little above zero must not read as "blocking".
+constexpr float kBlockThreshold = 0.25f;
+
+constexpr std::uint16_t kSonyVid = 0x054C;
+constexpr std::uint16_t kDualSensePid = 0x0CE6;
+constexpr std::uint16_t kDualSenseEdgePid = 0x0DF2;
+constexpr std::uint16_t kNintendoVid = 0x057E;
+constexpr std::uint16_t kProControllerPid = 0x2009;
+constexpr std::uint16_t kMicrosoftVid = 0x045E;
+
+// The Pro Controller's neutral 10-byte sub-command packet: both motors stopped, nothing else asked
+// for. Sent on release so a pad is never left buzzing after the window is gone.
+constexpr std::array<std::uint8_t, 10> kProNeutral{0x10, 0, 0x00, 0x01, 0x40,
+                                                   0x40, 0, 0x00, 0x01, 0x40};
+
+bool trace_enabled() {
+    static const bool on = std::getenv("DREAM_RENHDRUM_TRACE") != nullptr;
+    return on;
+}
+
+double seconds_now() {
+    static const auto origin = Clock::now();
+    return std::chrono::duration<double>(Clock::now() - origin).count();
+}
+
+std::int64_t microseconds_now() {
+    return std::chrono::duration_cast<std::chrono::microseconds>(Clock::now().time_since_epoch())
+        .count();
+}
+
+// The two-band sample the RenHDrum engines take. The pack's three-bit drive becomes amplitude; its
+// 4..30 Hz motor rate scales the low band, so a slow heavy effect sits near 60 Hz and a fast one
+// rises toward 120. The high band is the bite: stronger and higher on a short hit, so a blow reads as
+// sharp rather than soft.
+struct Sample {
+    float al = 0.0f, fl = 0.0f, ah = 0.0f, fh = 0.0f;
+};
+
+Sample sample_from(float power, std::uint8_t freq, std::uint32_t duration_ms) {
+    const float p = std::clamp(power, 0.0f, 1.0f);
+    const float rate = std::clamp((static_cast<float>(freq) - 4.0f) / 26.0f, 0.0f, 1.0f);
+    const bool short_hit = duration_ms > 0 && duration_ms <= 160;
+    Sample s;
+    s.al = p;
+    s.fl = 60.0f + 60.0f * rate;
+    s.ah = p * (short_hit ? 0.55f : 0.30f);
+    s.fh = short_hit ? 340.0f : 260.0f;
+    return s;
+}
+
+// The RenHDrum C ABI, resolved by name so the game runs with or without the DLL.
+struct Api {
+    bool tried = false;
+    bool ok = false;
+    std::string why;
+
+    std::uint32_t (*version)() = nullptr;
+
+    // Pro Controller
+    RenHdcEngine* (*engine_create)(bool, bool) = nullptr;
+    void (*engine_destroy)(RenHdcEngine*) = nullptr;
+    std::int32_t (*settings_default)(RenHdcSettings*) = nullptr;
+    std::int32_t (*engine_apply)(RenHdcEngine*, const RenHdcSettings*) = nullptr;
+    std::int32_t (*engine_push)(RenHdcEngine*, std::int64_t, bool, float, float, float, float) =
+        nullptr;
+    std::int32_t (*engine_tick)(RenHdcEngine*, std::int64_t, std::uint8_t*) = nullptr;
+
+    // DualSense
+    RenHdcDualSenseDsp* (*ds_create)(std::int32_t, bool) = nullptr;
+    void (*ds_destroy)(RenHdcDualSenseDsp*) = nullptr;
+    std::int32_t (*ds_set_half)(RenHdcDualSenseDsp*, bool, float, float, float, float) = nullptr;
+    std::int32_t (*ds_set_speaker)(RenHdcDualSenseDsp*, std::int32_t) = nullptr;
+    std::int32_t (*ds_fill)(RenHdcDualSenseDsp*, float*, std::size_t) = nullptr;
+    std::int32_t (*speaker_block)(std::int32_t, std::uint8_t*) = nullptr;
+    std::int32_t (*trigger_block)(std::int32_t, const std::uint8_t*, std::uint8_t*) = nullptr;
+
+    // Xbox
+    RenHdcXboxRumble* (*xbox_create)(bool) = nullptr;
+    void (*xbox_destroy)(RenHdcXboxRumble*) = nullptr;
+    std::int32_t (*xbox_push)(RenHdcXboxRumble*, std::int64_t, bool, float, float, float, float) =
+        nullptr;
+    std::int32_t (*xbox_tick)(RenHdcXboxRumble*, std::int64_t, std::uint16_t*) = nullptr;
+};
+
+template <typename T>
+void resolve(T& fn, HMODULE dll, const char* name) {
+    fn = reinterpret_cast<T>(reinterpret_cast<void*>(GetProcAddress(dll, name)));
+}
+
+// Loads renhdrum.dll from beside the game's own executable, never from the working directory or PATH:
+// a stray copy left by another title would otherwise be picked up and read as this one.
+bool load_api(Api& api) {
+    if (api.tried)
+        return api.ok;
+    api.tried = true;
+
+    if (const char* off = std::getenv("DREAM_RENHDRUM"); off && std::strcmp(off, "0") == 0) {
+        api.why = "switched off by DREAM_RENHDRUM=0";
+        return false;
+    }
+
+#if !defined(_WIN32)
+    api.why = "only supported on Windows";
+    return false;
+#else
+    wchar_t exe_path[MAX_PATH]{};
+    const DWORD len = GetModuleFileNameW(nullptr, exe_path, MAX_PATH);
+    if (len == 0 || len >= MAX_PATH) {
+        api.why = "cannot find the game executable";
+        return false;
+    }
+    wchar_t* slash = std::wcsrchr(exe_path, L'\\');
+    if (!slash) {
+        api.why = "cannot find the game executable";
+        return false;
+    }
+    if (std::wcslen(exe_path) + 16 >= MAX_PATH) {
+        api.why = "the game's folder path is too long";
+        return false;
+    }
+    std::wmemcpy(slash + 1, L"renhdrum.dll", 13);
+
+    HMODULE dll = LoadLibraryExW(exe_path, nullptr,
+                                 LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_SYSTEM32);
+    if (!dll) {
+        api.why = "renhdrum.dll not found beside the game";
+        return false;
+    }
+
+    resolve(api.version, dll, "renhdrum_version");
+    const std::uint32_t expected = static_cast<std::uint32_t>(RENHDRUM_VERSION) >> 8;
+    if (!api.version || ((api.version() >> 8) != expected)) {
+        FreeLibrary(dll);
+        api.version = nullptr;
+        api.why = "renhdrum.dll is a different version";
+        return false;
+    }
+
+    // Everything else is optional: a DLL missing one family's exports leaves only that family on
+    // SDL's rumble rather than failing the whole feature.
+    resolve(api.engine_create, dll, "renhdrum_engine_create");
+    resolve(api.engine_destroy, dll, "renhdrum_engine_destroy");
+    resolve(api.settings_default, dll, "renhdrum_settings_default");
+    resolve(api.engine_apply, dll, "renhdrum_engine_apply_settings");
+    resolve(api.engine_push, dll, "renhdrum_engine_push_half_sample");
+    resolve(api.engine_tick, dll, "renhdrum_engine_tick");
+
+    resolve(api.ds_create, dll, "renhdrum_dualsense_dsp_create");
+    resolve(api.ds_destroy, dll, "renhdrum_dualsense_dsp_destroy");
+    resolve(api.ds_set_half, dll, "renhdrum_dualsense_dsp_set_half_target");
+    resolve(api.ds_set_speaker, dll, "renhdrum_dualsense_dsp_set_speaker");
+    resolve(api.ds_fill, dll, "renhdrum_dualsense_dsp_fill_f32");
+    resolve(api.speaker_block, dll, "renhdrum_hd_haptics_speaker_block");
+    resolve(api.trigger_block, dll, "renhdrum_hd_haptics_trigger_block");
+
+    resolve(api.xbox_create, dll, "renhdrum_xbox_rumble_create");
+    resolve(api.xbox_destroy, dll, "renhdrum_xbox_rumble_destroy");
+    resolve(api.xbox_push, dll, "renhdrum_xbox_rumble_push_half_sample");
+    resolve(api.xbox_tick, dll, "renhdrum_xbox_rumble_tick");
+
+    api.ok = true;
+    return true;
+#endif
+}
+
+// The DualSense's own audio endpoint: the only way on Windows to reach its voice coils. Windows brings
+// the HID interface up long before the audio class one, hence the retry loop that calls this.
+SDL_AudioDeviceID find_dualsense_audio() {
+    SDL_AudioDeviceID found = 0;
+    int count = 0;
+    if (SDL_AudioDeviceID* ids = SDL_GetAudioPlaybackDevices(&count)) {
+        for (int i = 0; i < count && found == 0; ++i) {
+            const char* name = SDL_GetAudioDeviceName(ids[i]);
+            if (!name)
+                continue;
+            if (!std::strstr(name, "DualSense") && !std::strstr(name, "Wireless Controller"))
+                continue;
+            SDL_AudioSpec spec{};
+            if (SDL_GetAudioDeviceFormat(ids[i], &spec, nullptr) && spec.channels >= kChannels)
+                found = ids[i];
+        }
+        SDL_free(ids);
+    }
+    return found;
+}
+
+// One controller RenHDrum drives. Unique pointers keep these addresses stable, which matters because
+// the audio callback is handed the slot itself.
+struct Pad {
+    enum class Kind { DualSense, Xbox, Pro };
+
+    SDL_Gamepad* gamepad = nullptr;
+    SDL_Joystick* joystick = nullptr;
+    const Api* api = nullptr;
+    Kind kind = Kind::DualSense;
+    bool wireless = false;
+    // RenHDrum owns this pad's rumble, so the caller must not also play SDL's.
+    bool rumble = false;
+    // This pad takes adaptive-trigger effects.
+    bool triggers = false;
+    // The next update must send the current trigger effects even if they did not change: a pad that
+    // just appeared has never seen them.
+    bool triggers_fresh = false;
+    bool announced = false;
+
+    // Rumble envelope: the effect the guest asked for, and when it runs out.
+    bool live = false;
+    double until = 0.0;
+
+    // DualSense
+    std::mutex dsp_lock;
+    RenHdcDualSenseDsp* dsp = nullptr;
+    SDL_AudioStream* stream = nullptr;
+    SDL_AudioDeviceID device = 0;
+    double next_audio_try = 0.0;
+    bool speaker_on = false;
+    // A pad that refuses an output report is worth saying once, not sixty times a second.
+    bool effect_refused = false;
+
+    // Xbox
+    RenHdcXboxRumble* xbox = nullptr;
+    bool xbox_triggers = false;
+
+    // Pro Controller
+    RenHdcEngine* engine = nullptr;
+};
+
+}  // namespace
+
+struct Haptics::Impl {
+    HapticsOptions options;
+    Api api;
+    std::vector<std::unique_ptr<Pad>> pads;
+    TriggerPlanner planner;
+    float block_value = 0.0f;
+    bool attack_held = false;
+    std::string status = "haptics: off";
+
+    bool enabled() const noexcept { return options.wants_any() && api.ok; }
+    bool trigger_driving() const noexcept {
+        return api.ok && (options.trigger_feedback || options.trigger_resistance);
+    }
+
+    void refresh_status();
+    void attach_pad(SDL_Gamepad* gamepad);
+    void release_pad(Pad& p, bool quiet);
+    void release_all(bool quiet);
+    void push(Pad& p, bool right, const Sample& s);
+    void push_both(Pad& p, const Sample& s);
+    void tick(Pad& p, std::int64_t now_us);
+    void ds_try_audio(Pad& p, double now);
+    void ds_send(Pad& p, const std::uint8_t* block47);
+    void ds_set_speaker(Pad& p, bool on);
+    void send_trigger(Pad& p, bool right, const TriggerEffect& effect);
+    void silence_all();
+
+    static void SDLCALL audio_callback(void* userdata, SDL_AudioStream* stream,
+                                       int additional_amount, int total_amount);
+};
+
+void Haptics::Impl::refresh_status() {
+    if (!options.wants_any()) {
+        status = "haptics: off";
+        return;
+    }
+    if (!api.ok) {
+        status = "haptics: " + api.why;
+        return;
+    }
+    std::string line = "haptics: on";
+    int shown = 0;
+    for (const auto& p : pads) {
+        if (!p->rumble && !p->triggers)
+            continue;
+        line += shown == 0 ? " (" : ", ";
+        line += p->kind == Pad::Kind::DualSense  ? "DualSense"
+                : p->kind == Pad::Kind::Xbox     ? "Xbox"
+                                                 : "Pro Controller";
+        line += p->wireless ? " BT" : " USB";
+        if (p->triggers && trigger_driving())
+            line += ", triggers";
+        if (p->speaker_on)
+            line += ", speaker";
+        line += ")";
+        ++shown;
+    }
+    if (shown == 0)
+        line = "haptics: on, no supported pad yet";
+    status = line;
+}
+
+void Haptics::Impl::push(Pad& p, bool right, const Sample& s) {
+    switch (p.kind) {
+        case Pad::Kind::DualSense: {
+            if (!api.ds_set_half || !p.dsp)
+                return;
+            std::lock_guard<std::mutex> lock(p.dsp_lock);
+            api.ds_set_half(p.dsp, right, s.al, s.fl, s.ah, s.fh);
+            break;
+        }
+        case Pad::Kind::Xbox:
+            if (api.xbox_push && p.xbox)
+                api.xbox_push(p.xbox, microseconds_now(), right, s.al, s.fl, s.ah, s.fh);
+            break;
+        case Pad::Kind::Pro:
+            if (api.engine_push && p.engine)
+                api.engine_push(p.engine, microseconds_now(), right, s.al, s.fl, s.ah, s.fh);
+            break;
+    }
+}
+
+void Haptics::Impl::push_both(Pad& p, const Sample& s) {
+    push(p, false, s);
+    push(p, true, s);
+}
+
+// The two backends that pace their own packets: their tick says when the pad needs one.
+void Haptics::Impl::tick(Pad& p, std::int64_t now_us) {
+    if (p.kind == Pad::Kind::Xbox && p.xbox && api.xbox_tick && p.joystick) {
+        std::uint16_t motors[4]{};
+        if (api.xbox_tick(p.xbox, now_us, motors) == 1) {
+            // Short durations: a dropped packet must never leave a motor or a trigger stuck on.
+            SDL_RumbleJoystick(p.joystick, motors[0], motors[1], 2000);
+            if (p.xbox_triggers)
+                SDL_RumbleJoystickTriggers(p.joystick, motors[2], motors[3], 200);
+        }
+    } else if (p.kind == Pad::Kind::Pro && p.engine && api.engine_tick && p.joystick) {
+        std::uint8_t packet[10]{};
+        if (api.engine_tick(p.engine, now_us, packet) == 1)
+            SDL_SendJoystickEffect(p.joystick, packet, 10);
+    }
+}
+
+// One 47-byte DS5 effect state block, which SDL forwards to the pad's HID interface.
+void Haptics::Impl::ds_send(Pad& p, const std::uint8_t* block47) {
+    if (!p.joystick)
+        return;
+    if (SDL_SendJoystickEffect(p.joystick, block47, RENHDRUM_DS5_EFFECTS_SIZE) || p.effect_refused)
+        return;
+    p.effect_refused = true;
+    std::printf("renhdrum: this pad refused an output report; its triggers and speaker will do "
+                "nothing\n");
+}
+
+void Haptics::Impl::ds_set_speaker(Pad& p, bool on) {
+    if (!api.speaker_block || !api.ds_set_speaker || !p.dsp)
+        return;
+    std::uint8_t block[RENHDRUM_DS5_EFFECTS_SIZE]{};
+    if (api.speaker_block(on ? 1 : 0, block) != RENHDRUM_OK)
+        return;
+    ds_send(p, block);
+    {
+        std::lock_guard<std::mutex> lock(p.dsp_lock);
+        api.ds_set_speaker(p.dsp, on ? static_cast<std::int32_t>(kSpeakerPercent) : 0);
+    }
+    p.speaker_on = on;
+}
+
+void Haptics::Impl::send_trigger(Pad& p, bool right, const TriggerEffect& effect) {
+    if (!api.trigger_block || !p.triggers)
+        return;
+    std::uint8_t block[RENHDRUM_DS5_EFFECTS_SIZE]{};
+    if (api.trigger_block(right ? 1 : 0, effect.bytes, block) != RENHDRUM_OK)
+        return;
+    ds_send(p, block);
+}
+
+void Haptics::Impl::ds_try_audio(Pad& p, double now) {
+    // The endpoint is opened for the actuators and the speaker, never for the triggers alone: a pad
+    // whose rumble still comes from SDL must not be handed a silent stream as well.
+    if (!options.hd_rumble && !options.speaker)
+        return;
+    if (p.stream || !api.ds_create || !api.ds_fill || now < p.next_audio_try)
+        return;
+    p.next_audio_try = now + kAudioRetrySeconds;
+    if (!SDL_InitSubSystem(SDL_INIT_AUDIO))
+        return;
+    // A DualSense plugged in after the window opened is never registered without a pump.
+    SDL_PumpEvents();
+    const SDL_AudioDeviceID device = find_dualsense_audio();
+    if (device == 0)
+        return;
+
+    SDL_AudioSpec spec{};
+    spec.format = SDL_AUDIO_F32;
+    spec.channels = kChannels;
+    spec.freq = 48000;
+    SDL_AudioStream* stream =
+        SDL_OpenAudioDeviceStream(device, &spec, &Haptics::Impl::audio_callback, &p);
+    if (!stream)
+        return;
+    if (!SDL_ResumeAudioStreamDevice(stream)) {
+        SDL_DestroyAudioStream(stream);
+        return;
+    }
+    p.stream = stream;
+    p.device = device;
+    // The audio path is live, so this pad can be driven by haptics instead of SDL's motors.
+    p.rumble = options.hd_rumble && p.dsp != nullptr;
+    if (p.rumble && p.joystick)
+        SDL_RumbleJoystick(p.joystick, 0, 0, 0);  // stop SDL's motors competing with the actuators
+    if (options.speaker && options.hd_rumble)
+        ds_set_speaker(p, true);
+    if (trace_enabled())
+        std::printf("renhdrum: DualSense audio endpoint opened (device %u)\n",
+                    static_cast<unsigned>(device));
+    refresh_status();
+}
+
+// SDL calls this on its audio thread: it only ever touches the DSP under the slot's own lock, and the
+// slot clears that pointer before the stream is destroyed.
+void SDLCALL Haptics::Impl::audio_callback(void* userdata, SDL_AudioStream* stream,
+                                           int additional_amount, int total_amount) {
+    (void)total_amount;
+    auto* p = static_cast<Pad*>(userdata);
+    if (!p || !stream || additional_amount <= 0)
+        return;
+    const int bytes_per_frame = kChannels * static_cast<int>(sizeof(float));
+    int frames = additional_amount / bytes_per_frame;
+    if (frames <= 0)
+        return;
+    float chunk[kAudioFrames * kChannels];
+    while (frames > 0) {
+        const int n = std::min(frames, kAudioFrames);
+        {
+            std::lock_guard<std::mutex> lock(p->dsp_lock);
+            const auto fill = p->api ? p->api->ds_fill : nullptr;
+            if (!p->dsp || !fill || fill(p->dsp, chunk, static_cast<std::size_t>(n)) < 0)
+                std::fill(chunk, chunk + n * kChannels, 0.0f);
+        }
+        SDL_PutAudioStreamData(stream, chunk, n * bytes_per_frame);
+        frames -= n;
+    }
+}
+
+void Haptics::Impl::attach_pad(SDL_Gamepad* gamepad) {
+    if (!gamepad || !enabled())
+        return;
+    for (const auto& existing : pads)
+        if (existing->gamepad == gamepad)
+            return;
+
+    const std::uint16_t vid = SDL_GetGamepadVendor(gamepad);
+    const std::uint16_t pid = SDL_GetGamepadProduct(gamepad);
+    const SDL_JoystickConnectionState connection = SDL_GetGamepadConnectionState(gamepad);
+    const bool wireless = connection == SDL_JOYSTICK_CONNECTION_WIRELESS;
+    const bool want_rumble = options.hd_rumble;
+    const bool want_triggers = trigger_driving();
+
+    auto slot = std::make_unique<Pad>();
+    slot->api = &api;
+    slot->gamepad = gamepad;
+    slot->joystick = SDL_GetGamepadJoystick(gamepad);
+    slot->wireless = wireless;
+
+    if (vid == kSonyVid && (pid == kDualSensePid || pid == kDualSenseEdgePid)) {
+        // The 4-channel endpoint does not exist over Bluetooth, and the combined report that replaces
+        // it is not implemented here, so a wireless DualSense keeps SDL's own rumble.
+        if (wireless) {
+            if (trace_enabled())
+                std::printf("renhdrum: DualSense over Bluetooth: plain rumble\n");
+            return;
+        }
+        slot->kind = Pad::Kind::DualSense;
+        if (want_rumble && api.ds_create && api.ds_fill) {
+            slot->dsp = api.ds_create(static_cast<std::int32_t>(options.strength), true);
+            if (!slot->dsp)
+                return;
+        }
+        slot->triggers = want_triggers && api.trigger_block != nullptr;
+        slot->triggers_fresh = true;
+        pads.push_back(std::move(slot));
+        // Audio comes up after the HID interface; rumble is claimed only once it does, so a pad
+        // without it falls back instead of going silent.
+        ds_try_audio(*pads.back(), seconds_now());
+    } else if (vid == kNintendoVid && pid == kProControllerPid) {
+        if (!want_rumble || !api.engine_create || !api.engine_push || !api.engine_tick)
+            return;
+        slot->kind = Pad::Kind::Pro;
+        RenHdcEngine* engine = api.engine_create(wireless, true);
+        if (!engine)
+            return;
+        if (api.settings_default && api.engine_apply) {
+            RenHdcSettings settings{};
+            if (api.settings_default(&settings) == RENHDRUM_OK)
+                api.engine_apply(engine, &settings);
+        }
+        slot->engine = engine;
+        slot->rumble = true;
+        pads.push_back(std::move(slot));
+    } else if (SDL_GetGamepadType(gamepad) == SDL_GAMEPAD_TYPE_XBOXONE || vid == kMicrosoftVid) {
+        if (!want_rumble || !api.xbox_create || !api.xbox_push || !api.xbox_tick)
+            return;
+        slot->kind = Pad::Kind::Xbox;
+        RenHdcXboxRumble* xbox = api.xbox_create(wireless);
+        if (!xbox)
+            return;
+        slot->xbox = xbox;
+        slot->rumble = true;
+        // Trigger motors need the raw HID path; SDL says whether this pad has them.
+        if (SDL_Joystick* joystick = slot->joystick)
+            slot->xbox_triggers = SDL_GetBooleanProperty(SDL_GetJoystickProperties(joystick),
+                                                         "SDL.joystick.cap.trigger_rumble", false);
+        pads.push_back(std::move(slot));
+    } else {
+        return;
+    }
+
+    if (trace_enabled()) {
+        const char* name = SDL_GetGamepadName(gamepad);
+        std::printf("renhdrum: attached \"%s\" (%s)\n", name && *name ? name : "?",
+                    pads.back()->kind == Pad::Kind::DualSense  ? "DualSense"
+                    : pads.back()->kind == Pad::Kind::Xbox     ? "Xbox"
+                                                               : "Pro Controller");
+    }
+    pads.back()->announced = true;
+    refresh_status();
+}
+
+void Haptics::Impl::release_pad(Pad& p, bool quiet) {
+    if (!quiet) {
+        if (p.rumble)
+            push_both(p, Sample{});
+        if (p.triggers) {
+            send_trigger(p, false, trigger_off());
+            send_trigger(p, true, trigger_off());
+        }
+    }
+
+    switch (p.kind) {
+        case Pad::Kind::DualSense: {
+            if (p.speaker_on)
+                ds_set_speaker(p, false);
+            // Detach the handle first: a callback already in flight must see null, not freed memory.
+            RenHdcDualSenseDsp* dsp = nullptr;
+            {
+                std::lock_guard<std::mutex> lock(p.dsp_lock);
+                dsp = p.dsp;
+                p.dsp = nullptr;
+            }
+            SDL_AudioStream* stream = p.stream;
+            p.stream = nullptr;
+            if (stream)
+                SDL_DestroyAudioStream(stream);  // joins the callback
+            if (dsp && api.ds_destroy)
+                api.ds_destroy(dsp);
+            break;
+        }
+        case Pad::Kind::Xbox:
+            if (p.joystick) {
+                SDL_RumbleJoystick(p.joystick, 0, 0, 0);
+                if (p.xbox_triggers)
+                    SDL_RumbleJoystickTriggers(p.joystick, 0, 0, 0);
+            }
+            if (p.xbox && api.xbox_destroy)
+                api.xbox_destroy(p.xbox);
+            p.xbox = nullptr;
+            break;
+        case Pad::Kind::Pro:
+            if (p.joystick)
+                SDL_SendJoystickEffect(p.joystick, kProNeutral.data(),
+                                       static_cast<int>(kProNeutral.size()));
+            if (p.engine && api.engine_destroy)
+                api.engine_destroy(p.engine);
+            p.engine = nullptr;
+            break;
+    }
+    p.rumble = false;
+    p.triggers = false;
+    p.live = false;
+}
+
+void Haptics::Impl::release_all(bool quiet) {
+    for (auto& p : pads)
+        release_pad(*p, quiet);
+    pads.clear();
+    planner.reset();
+    refresh_status();
+}
+
+void Haptics::Impl::silence_all() {
+    for (auto& p : pads) {
+        if (p->rumble)
+            push_both(*p, Sample{});
+        p->live = false;
+    }
+}
+
+Haptics::Haptics() : impl_(std::make_unique<Impl>()) {}
+
+Haptics::~Haptics() {
+    stop();
+}
+
+void Haptics::configure(const HapticsOptions& options) {
+    impl_->options = options;
+    impl_->options.strength = std::clamp(options.strength, 10, 100);
+    // The speaker is part of the audio path, so it makes no sense without HD rumble feeding it.
+    if (!impl_->options.hd_rumble)
+        impl_->options.speaker = false;
+    if (!impl_->options.wants_any()) {
+        impl_->status = "haptics: off";
+        return;
+    }
+    if (!load_api(impl_->api)) {
+        impl_->status = "haptics: " + impl_->api.why;
+        return;
+    }
+    impl_->status = "haptics: on, no supported pad yet";
+    if (trace_enabled()) {
+        const std::uint32_t ver = impl_->api.version ? impl_->api.version() : 0;
+        std::printf("renhdrum: loaded version %u.%u.%u\n", (ver >> 16) & 0xFF, (ver >> 8) & 0xFF,
+                    ver & 0xFF);
+    }
+}
+
+const HapticsOptions& Haptics::options() const {
+    return impl_->options;
+}
+
+void Haptics::attach(SDL_Gamepad* gamepad) {
+    impl_->attach_pad(gamepad);
+}
+
+void Haptics::detach(SDL_Gamepad* gamepad) {
+    for (auto it = impl_->pads.begin(); it != impl_->pads.end(); ++it) {
+        if ((*it)->gamepad != gamepad)
+            continue;
+        impl_->release_pad(**it, false);
+        impl_->pads.erase(it);
+        impl_->refresh_status();
+        return;
+    }
+}
+
+bool Haptics::claims(SDL_Gamepad* gamepad) const {
+    for (const auto& p : impl_->pads)
+        if (p->gamepad == gamepad)
+            return p->rumble;
+    return false;
+}
+
+void Haptics::pack(const HapticsEffect& effect) {
+    if (!impl_->enabled())
+        return;
+    const double now = seconds_now();
+    if (effect.power <= 0.001f) {
+        impl_->silence_all();
+        return;
+    }
+    if (impl_->trigger_driving())
+        impl_->planner.impact(effect.power, now);
+
+    const Sample s = sample_from(effect.power, effect.freq, effect.duration_ms);
+    const double life = std::max(static_cast<double>(effect.duration_ms) / 1000.0, kIdleStopSeconds);
+    for (auto& p : impl_->pads) {
+        if (!p->rumble)
+            continue;
+        impl_->push_both(*p, s);
+        p->live = true;
+        p->until = now + life;
+    }
+}
+
+void Haptics::set_controls(float block_value, bool attack_held) {
+    impl_->block_value = std::clamp(block_value, 0.0f, 1.0f);
+    impl_->attack_held = attack_held;
+}
+
+void Haptics::update() {
+    if (!impl_->enabled())
+        return;
+    const double now = seconds_now();
+    const std::int64_t now_us = microseconds_now();
+
+    for (auto& p : impl_->pads) {
+        if (p->kind == Pad::Kind::DualSense)
+            impl_->ds_try_audio(*p, now);
+        if (p->rumble && p->live && now >= p->until) {
+            impl_->push_both(*p, Sample{});
+            p->live = false;
+        }
+        impl_->tick(*p, now_us);
+    }
+
+    if (!impl_->trigger_driving())
+        return;
+    impl_->planner.set_block(impl_->block_value > kBlockThreshold, now);
+    impl_->planner.set_attack(impl_->attack_held, now);
+    const TriggerPlanner::Output out = impl_->planner.update(now);
+    for (auto& p : impl_->pads) {
+        if (!p->triggers)
+            continue;
+        if (p->triggers_fresh || out.left.changed)
+            impl_->send_trigger(*p, false, out.left.effect);
+        if (p->triggers_fresh || out.right.changed)
+            impl_->send_trigger(*p, true, out.right.effect);
+        p->triggers_fresh = false;
+    }
+}
+
+void Haptics::stop() {
+    if (!impl_)
+        return;
+    impl_->release_all(false);
+    impl_->status = "haptics: off";
+}
+
+const std::string& Haptics::status() const {
+    return impl_->status;
+}
+
+}  // namespace dream::render
