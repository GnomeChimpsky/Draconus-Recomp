diff --git b/render/include/dream/render/haptics.h b/render/include/dream/render/haptics.h
new file mode 100644
index 0000000..0dbce0d
--- /dev/null
+++ b/render/include/dream/render/haptics.h
@@ -0,0 +1,96 @@
+// RenHDrum-backed haptics for the pads the plain SDL rumble cannot reach.
+//
+// SDL's rumble call turns a pad's two motors on for a number of milliseconds. That is all a Dreamcast
+// jump pack ever asked for, but a DualSense is not two motors: it has two voice-coil actuators driven
+// by its own 4-channel USB audio endpoint, two adaptive triggers that take an effect each, and a
+// speaker. RenHDrum (MIT, Three-Dola) is the engine that turns a two-band rumble sample into those
+// three things, and this class is the host side of it: load the DLL, claim the pads, feed it the
+// jump pack's effects, and turn the block and attack buttons into trigger feedback.
+//
+// Everything here degrades to the old behaviour: no DLL, a DLL from another version, a pad RenHDrum
+// does not know, or the feature switched off in the launcher all leave SDL's rumble in charge.
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include "dream/render/trigger_effect.h"
+
+struct SDL_Gamepad;
+
+namespace dream::render {
+
+// What the launcher's Controller tab asked for.
+struct HapticsOptions {
+    // Drive claimed pads through RenHDrum instead of SDL's plain motors. A DualSense gets its
+    // voice-coil actuators over USB audio, a Pro Controller gets HD Rumble packets, an Xbox pad gets
+    // all four motors.
+    bool hd_rumble = false;
+    // The block and attack buttons pulse the trigger that made them, when the game reports an impact.
+    bool trigger_feedback = false;
+    // Holding the block button pushes back, so the guard has weight before anything hits it.
+    bool trigger_resistance = false;
+    // Audible taps out of the DualSense speaker, synthesised by RenHDrum from the rumble.
+    bool speaker = false;
+    // RenHDrum's final output gain, percent (10-100).
+    int strength = 100;
+
+    bool wants_any() const noexcept {
+        return hd_rumble || trigger_feedback || trigger_resistance || speaker;
+    }
+};
+
+// One jump pack effect as the Maple device decoded it; see maple::JumpPack::Effect.
+struct HapticsEffect {
+    float power = 0.0f;          // 0..1, seven steps from the pack's two drive fields
+    std::uint32_t duration_ms = 0;
+    std::uint8_t freq = 0;       // the pack's own 4..30 Hz motor rate
+    bool continuous = false;
+};
+
+class Haptics {
+public:
+    Haptics();
+    ~Haptics();
+    Haptics(const Haptics&) = delete;
+    Haptics& operator=(const Haptics&) = delete;
+
+    // Applies the options and loads renhdrum.dll beside the executable on first use. Safe to call
+    // more than once; a run with every option off never touches the DLL.
+    void configure(const HapticsOptions& options);
+    const HapticsOptions& options() const;
+
+    // Pads are opened and closed by the window, so they are claimed and released here. attach() is
+    // a no-op for a pad it cannot drive, which is what leaves that pad on the SDL path.
+    void attach(SDL_Gamepad* pad);
+    void detach(SDL_Gamepad* pad);
+
+    // True when RenHDrum drives this pad. The caller must skip SDL's own rumble for it or the effect
+    // plays twice.
+    bool claims(SDL_Gamepad* pad) const;
+
+    // A guest vibration effect. A zero effect stops everything immediately.
+    void pack(const HapticsEffect& effect);
+
+    // Once a frame, after the pads have been polled: the block button's travel (0..1) and whether
+    // the attack button is down.
+    void set_controls(float block_value, bool attack_held);
+
+    // Once a frame: retires finished effects, ticks the packet-paced backends, sends whatever the
+    // trigger planner changed.
+    void update();
+
+    // Releases the triggers and the speaker and drops every pad. Called when the window closes, and
+    // it must also be reachable from the launcher's exit path because ExitProcess skips destructors.
+    void stop();
+
+    // One line for the log: what was loaded and which pad it drives.
+    const std::string& status() const;
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace dream::render
diff --git b/render/include/dream/render/trigger_effect.h b/render/include/dream/render/trigger_effect.h
new file mode 100644
index 0000000..1a8085b
--- /dev/null
+++ b/render/include/dream/render/trigger_effect.h
@@ -0,0 +1,114 @@
+// DualSense adaptive-trigger effects and the block/attack trigger planner.
+//
+// The bytes in a TriggerEffect are the 11-byte "zone effect" block a DualSense takes for one trigger:
+// 10 zones over the travel, a 3-bit strength per zone, plus a mode byte. The encodings and the mode
+// numbers come from RenHDrum's documented DualSense support (MIT, Three-Dola), which itself credits
+// Nielk1's reverse engineering; the test vectors in tests/test_trigger_effect.cpp are the same ones
+// its own suite pins, so a byte that changes here is a byte that would stop a real controller.
+//
+// Nothing here touches SDL or the DLL: it is pure data and time, so the whole feel of the feature is
+// unit-tested without a controller or a GPU. The window owns a TriggerPlanner and asks it, once a
+// frame, which effects changed.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace dream::render {
+
+// One adaptive-trigger effect, exactly as it goes on the wire.
+struct TriggerEffect {
+    static constexpr std::size_t kSize = 11;
+    static constexpr int kZones = 10;
+    std::uint8_t bytes[kSize]{};
+
+    friend bool operator==(const TriggerEffect& a, const TriggerEffect& b) noexcept;
+    friend bool operator!=(const TriggerEffect& a, const TriggerEffect& b) noexcept {
+        return !(a == b);
+    }
+};
+
+// Free trigger, no resistance.
+TriggerEffect trigger_off();
+// Resistance from `start_zone` (0-9) to the end of the travel, strength 1-8. This is the "you are
+// pushing against something" effect: holding the button down feels like compressing a spring.
+TriggerEffect trigger_feedback(int start_zone, int strength);
+// Resistance between two zones that breaks when pulled past the end, like a gun trigger.
+TriggerEffect trigger_weapon(int start_zone, int end_zone, int strength);
+// Buzzing inside the trigger from `start_zone` on: amplitude 1-8, frequency in Hz (1-255).
+TriggerEffect trigger_vibration(int start_zone, int amplitude, int frequency);
+
+// Which trigger an effect is for. The left trigger blocks, the right one attacks.
+enum class TriggerSide { Left, Right };
+
+// What the player asked for on the launcher's Controller tab.
+struct TriggerFeel {
+    // Hold the left trigger and feel it resist, for as long as the block is held.
+    bool resistance = true;
+    int resistance_zone = 1;      // 0-9: where the resistance starts biting
+    int resistance_strength = 2;  // 1-8: how hard it pushes back
+};
+
+// Turns the block button, the attack button and the jump pack's effects into per-trigger feedback.
+//
+// The title is the only source of "something was hit": its Puru Puru effects fire on a block that
+// connects and on an attack that lands (measured on hardware), and nothing else in the game state is
+// visible to the host. So the plan is the same one a player would describe:
+//   * left trigger held               -> resistance, so the block has weight before anything happens
+//   * an effect while it is held      -> a sharp buzz in the left trigger: the block took a hit
+//   * right trigger pressed           -> a faint buzz: the swing itself
+//   * an effect within the swing window -> a hard buzz in the right trigger: the hit connected
+class TriggerPlanner {
+public:
+    // Re-arming is cheap and idempotent, so the caller may set the feel every frame.
+    void set_feel(const TriggerFeel& feel) noexcept { feel_ = feel; }
+    const TriggerFeel& feel() const noexcept { return feel_; }
+
+    // Edges, in seconds on a monotonic clock. Calling with the same value every frame is fine.
+    void set_block(bool held, double now) noexcept;
+    void set_attack(bool held, double now) noexcept;
+
+    // The jump pack fired: `power` is the decoded 0..1 strength. Returns true when it counted as an
+    // impact; a faint effect is the game's own ambience and must not punch the triggers.
+    bool impact(float power, double now) noexcept;
+
+    struct Side {
+        TriggerEffect effect{};
+        bool changed = false;
+    };
+    struct Output {
+        Side left;
+        Side right;
+    };
+    // The effects to send this frame. Only sides whose effect differs from the last one are marked
+    // changed, so a held block does not resend the same block sixty times a second.
+    Output update(double now);
+
+    void reset() noexcept;
+
+    // Thresholds, public so the tests and the diagnostics name the same numbers as the code.
+    static constexpr float kImpactPower = 0.20f;   // below this it is ambience, not a hit
+    static constexpr double kBlockPulse = 0.110;   // how long the block-hit buzz lasts
+    static constexpr double kHitPulse = 0.090;     // how long the landing-blow buzz lasts
+    static constexpr double kSwingPulse = 0.055;   // the swing itself, before anything lands
+    static constexpr double kSwingWindow = 0.400;  // an impact this soon after the press is our hit
+    static constexpr double kMinGap = 0.070;       // never machine-gun two pulses into one trigger
+
+private:
+    TriggerEffect desired(TriggerSide side, double now) const noexcept;
+
+    TriggerFeel feel_{};
+    bool block_held_ = false;
+    bool attack_held_ = false;
+    double block_pulse_until_ = -1.0;
+    double hit_pulse_until_ = -1.0;
+    double swing_pulse_until_ = -1.0;
+    double swing_window_until_ = -1.0;
+    double last_left_pulse_ = -1.0;
+    double last_right_pulse_ = -1.0;
+    TriggerEffect sent_left_{};
+    TriggerEffect sent_right_{};
+    bool primed_ = false;
+};
+
+}  // namespace dream::render
