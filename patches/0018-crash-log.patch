+
+namespace {
+
+std::FILE* g_file = nullptr;
+std::string g_path;
+std::string g_context;
+dream::crashlog::Snapshot g_snapshot = nullptr;
+bool g_writing = false;
+std::time_t g_started = 0;
+
+#if defined(_WIN32)
+struct Module {
+    std::uintptr_t base;
+    std::uintptr_t size;
+    char name[64];
+};
+Module g_modules[64];
+unsigned g_module_count = 0;
+#endif
+
+// --- small helpers ---------------------------------------------------------------------------
+
+std::string narrow(const std::filesystem::path& path) {
+#if defined(_WIN32)
+    const std::wstring wide = path.wstring();
+    if (wide.empty())
+        return {};
+    const int size = WideCharToMultiByte(CP_UTF8, 0, wide.c_str(), -1, nullptr, 0, nullptr, nullptr);
+    if (size <= 0)
+        return {};
+    std::string text(static_cast<std::size_t>(size - 1), '\0');
+    WideCharToMultiByte(CP_UTF8, 0, wide.c_str(), -1, text.data(), size, nullptr, nullptr);
+    return text;
+#else
+    return path.string();
+#endif
+}
+
+std::string local_stamp(bool for_file_name) {
+    const std::time_t now = std::time(nullptr);
+    std::tm parts{};
+#if defined(_WIN32)
+    localtime_s(&parts, &now);
+#else
+    localtime_r(&now, &parts);
+#endif
+    char text[32] = {};
+    std::strftime(text, sizeof text, for_file_name ? "%Y%m%d-%H%M%S" : "%Y-%m-%d %H:%M:%S",
+                  &parts);
+    return text;
+}
+
+// Only used from the crash handler, where the CRT's time functions could be the thing that broke.
+void crash_stamp(char* out, std::size_t size) {
+#if defined(_WIN32)
+    SYSTEMTIME now{};
+    GetLocalTime(&now);
+    std::snprintf(out, size, "%04u-%02u-%02u %02u:%02u:%02u", now.wYear, now.wMonth, now.wDay,
+                  now.wHour, now.wMinute, now.wSecond);
+#else
+    std::time_t now = std::time(nullptr);
+    std::tm parts{};
+    localtime_r(&now, &parts);
+    std::strftime(out, size, "%Y-%m-%d %H:%M:%S", &parts);
+#endif
+}
+
+void out(const char* format, ...) {
+    std::va_list args;
+    va_start(args, format);
+    std::vfprintf(stderr, format, args);
+    va_end(args);
+}
+
+std::FILE* open_log_file(const std::filesystem::path& path) {
+#if defined(_WIN32)
+    return _wfopen(path.c_str(), L"w");
+#else
+    return std::fopen(path.c_str(), "w");
+#endif
+}
+
+std::string exe_path() {
+#if defined(_WIN32)
+    wchar_t buffer[1024] = {};
+    const DWORD size = GetModuleFileNameW(nullptr, buffer, 1024);
+    if (size == 0)
+        return {};
+    return narrow(std::filesystem::path(std::wstring(buffer, size)));
+#else
+    char buffer[1024] = {};
+    const ssize_t size = readlink("/proc/self/exe", buffer, sizeof buffer - 1);
+    return size > 0 ? std::string(buffer, static_cast<std::size_t>(size)) : std::string();
+#endif
+}
+
+std::string os_description() {
+#if defined(_WIN32)
+    // RtlGetVersion reports the machine's real build. GetVersionEx is manifest-dependent and can
+    // claim Windows 8 on a machine that is not, which is worse than no version at all in a report.
+    OSVERSIONINFOW version{};
+    version.dwOSVersionInfoSize = sizeof version;
+    bool known = false;
+    if (const HMODULE ntdll = GetModuleHandleW(L"ntdll.dll")) {
+        using RtlGetVersionFn = LONG(WINAPI*)(OSVERSIONINFOW*);
+        const auto rtl_get_version = reinterpret_cast<RtlGetVersionFn>(
+            reinterpret_cast<void*>(GetProcAddress(ntdll, "RtlGetVersion")));
+        known = rtl_get_version && rtl_get_version(&version) == 0;
+    }
+    char windows[64] = "Windows";
+    if (known)
+        std::snprintf(windows, sizeof windows, "Windows %lu.%lu.%lu",
+                      static_cast<unsigned long>(version.dwMajorVersion),
+                      static_cast<unsigned long>(version.dwMinorVersion),
+                      static_cast<unsigned long>(version.dwBuildNumber));
+    SYSTEM_INFO info{};
+    GetNativeSystemInfo(&info);
+    const char* arch = "unknown";
+    switch (info.wProcessorArchitecture) {
+        case PROCESSOR_ARCHITECTURE_AMD64:
+            arch = "x64";
+            break;
+        case PROCESSOR_ARCHITECTURE_INTEL:
+            arch = "x86";
+            break;
+        case PROCESSOR_ARCHITECTURE_ARM:
+            arch = "arm";
+            break;
+#ifdef PROCESSOR_ARCHITECTURE_ARM64
+        case PROCESSOR_ARCHITECTURE_ARM64:
+            arch = "arm64";
+            break;
+#endif
+        default:
+            break;
+    }
+    char text[160] = {};
+    std::snprintf(text, sizeof text, "%s (%s), %lu logical CPUs", windows, arch,
+                  static_cast<unsigned long>(info.dwNumberOfProcessors));
+    return text;
+#elif defined(__linux__) || defined(__APPLE__)
+    struct utsname info {};
+    if (uname(&info) == 0)
+        return std::string(info.sysname) + " " + info.release + " " + info.machine;
+    return "unknown host";
+#else
+    return "unknown host";
+#endif
+}
+
+// Newest `keep` session logs survive; a player who leaves the setting on should not accumulate
+// files forever, and the newest is the one a report wants anyway.
+void prune(const std::filesystem::path& dir, std::size_t keep) {
+    std::vector<std::filesystem::path> logs;
+    std::error_code ec;
+    for (std::filesystem::directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec)) {
+        std::error_code entry_error;
+        if (!it->is_regular_file(entry_error))
+            continue;
+        const std::string name = it->path().filename().string();
+        if (name.rfind("draconus-", 0) == 0 && it->path().extension() == ".log")
+            logs.push_back(it->path());
+    }
+    if (logs.size() <= keep)
+        return;
+    const auto stamp = [](const std::filesystem::path& path) {
+        std::error_code error;
+        const auto time = std::filesystem::last_write_time(path, error);
+        return error ? std::filesystem::file_time_type::min() : time;
+    };
+    std::sort(logs.begin(), logs.end(),
+              [&](const std::filesystem::path& a, const std::filesystem::path& b) {
+                  return stamp(a) < stamp(b);
+              });
+    for (std::size_t i = 0; i + keep < logs.size(); ++i)
+        std::filesystem::remove(logs[i], ec);
+}
+
+bool redirect_into(std::FILE* file) {
+#if defined(_WIN32)
+    const int fd = _fileno(file);
+    return fd >= 0 && _dup2(fd, _fileno(stdout)) == 0 && _dup2(fd, _fileno(stderr)) == 0;
+#else
+    const int fd = fileno(file);
+    return fd >= 0 && dup2(fd, fileno(stdout)) >= 0 && dup2(fd, fileno(stderr)) >= 0;
+#endif
+}
+
+#if defined(_WIN32)
+void collect_modules() {
+    const HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPMODULE, GetCurrentProcessId());
+    if (snapshot == INVALID_HANDLE_VALUE)
+        return;
+    MODULEENTRY32W entry{};
+    entry.dwSize = sizeof entry;
+    if (Module32FirstW(snapshot, &entry)) {
+        do {
+            if (g_module_count == static_cast<unsigned>(std::size(g_modules)))
+                break;
+            Module& module = g_modules[g_module_count];
+            module.base = reinterpret_cast<std::uintptr_t>(entry.modBaseAddr);
+            module.size = entry.modBaseSize;
+            WideCharToMultiByte(CP_UTF8, 0, entry.szModule, -1, module.name,
+                                static_cast<int>(sizeof module.name), nullptr, nullptr);
+            ++g_module_count;
+        } while (Module32NextW(snapshot, &entry));
+    }
+    CloseHandle(snapshot);
+}
+
+// Module plus offset, so the build's link map (or PDB) names the frame without guessing which DLL
+// the address belongs to.
+void format_address(std::uintptr_t address, char* out, std::size_t size) {
+    for (unsigned i = 0; i < g_module_count; ++i) {
+        const Module& module = g_modules[i];
+        if (address >= module.base && address < module.base + module.size) {
+            std::snprintf(out, size, "%s+0x%llx", module.name,
+                          static_cast<unsigned long long>(address - module.base));
+            return;
+        }
+    }
+    std::snprintf(out, size, "0x%llx", static_cast<unsigned long long>(address));
+}
+#endif
+
+#if defined(_WIN32)
+const char* exception_name(unsigned long code) {
+    switch (code) {
+        case 0xC0000005:  // EXCEPTION_ACCESS_VIOLATION
+            return "access violation";
+        case 0xC000001D:  // EXCEPTION_ILLEGAL_INSTRUCTION
+            return "illegal instruction";
+        case 0xC0000094:  // EXCEPTION_INT_DIVIDE_BY_ZERO
+            return "integer divide by zero";
+        case 0xC0000096:  // EXCEPTION_PRIV_INSTRUCTION
+            return "privileged instruction";
+        case 0xC00000FD:  // EXCEPTION_STACK_OVERFLOW
+            return "stack overflow";
+        case 0xC0000374:  // STATUS_HEAP_CORRUPTION
+            return "heap corruption";
+        case 0xC0000409:  // STATUS_STACK_BUFFER_OVERRUN
+            return "stack buffer overrun";
+        case 0x80000003:  // EXCEPTION_BREAKPOINT
+            return "breakpoint";
+        case 0xE06D7363:  // Visual C++ exception object
+            return "unhandled C++ exception";
+        default:
+            return "exception";
+    }
+}
+#endif
+
+// Kept free of C++ objects with destructors: guarded_crash() wraps it in __try, which MSVC (C2712)
+// refuses in a function that needs unwinding. Out of memory at this point must not stop the report.
+void write_crash(const char* what, void* pointers) {
+    if (g_writing)
+        return;
+    g_writing = true;
+    char stamp[40] = {};
+    crash_stamp(stamp, sizeof stamp);
+    out("\n=== crash %s ===\n", stamp);
+    out("%s\n", what ? what : "fatal condition");
+
+#if defined(_WIN32)
+    out("thread: %lu\n", static_cast<unsigned long>(GetCurrentThreadId()));
+    const auto* info = static_cast<EXCEPTION_POINTERS*>(pointers);
+    if (info && info->ExceptionRecord) {
+        const EXCEPTION_RECORD& record = *info->ExceptionRecord;
+        char where[160] = {};
+        format_address(reinterpret_cast<std::uintptr_t>(record.ExceptionAddress), where,
+                       sizeof where);
+        out("exception: 0x%08lx (%s) at %s\n",
+            static_cast<unsigned long>(record.ExceptionCode),
+            exception_name(static_cast<unsigned long>(record.ExceptionCode)), where);
+        if (record.ExceptionCode == 0xC0000005 && record.NumberParameters >= 2) {
+            const char* access = "other";
+            if (record.ExceptionInformation[0] == 0)
+                access = "read";
+            else if (record.ExceptionInformation[0] == 1)
+                access = "write";
+            else if (record.ExceptionInformation[0] == 8)
+                access = "execute";
+            char target[160] = {};
+            format_address(static_cast<std::uintptr_t>(record.ExceptionInformation[1]), target,
+                           sizeof target);
+            out("access: %s of %s\n", access, target);
+        }
+        if (info->ContextRecord) {
+#if defined(_M_X64)
+            out("registers: rip 0x%llx rsp 0x%llx rbp 0x%llx\n",
+                static_cast<unsigned long long>(info->ContextRecord->Rip),
+                static_cast<unsigned long long>(info->ContextRecord->Rsp),
+                static_cast<unsigned long long>(info->ContextRecord->Rbp));
+#elif defined(_M_IX86)
+            out("registers: eip 0x%08lx esp 0x%08lx ebp 0x%08lx\n",
+                static_cast<unsigned long>(info->ContextRecord->Eip),
+                static_cast<unsigned long>(info->ContextRecord->Esp),
+                static_cast<unsigned long>(info->ContextRecord->Ebp));
+#endif
+        }
+    }
+    out("host stack (module+offset, innermost first):\n");
+    void* frames[48] = {};
+    const unsigned short count = RtlCaptureStackBackTrace(1, 48, frames, nullptr);
+    for (unsigned short i = 0; i < count && i < 32; ++i) {
+        char where[160] = {};
+        format_address(reinterpret_cast<std::uintptr_t>(frames[i]), where, sizeof where);
+        out("  %02u  %s\n", static_cast<unsigned>(i), where);
+    }
+#elif defined(__linux__) || defined(__APPLE__)
+    void* frames[48] = {};
+    const int count = ::backtrace(frames, 48);
+    char** names = count > 0 ? ::backtrace_symbols(frames, count) : nullptr;
+    out("host stack (innermost first):\n");
+    for (int i = 1; i < count && i < 32; ++i)
+        out("  %02d  %s\n", i, names ? names[i] : "?");
+    std::free(names);
+    (void)pointers;
+#else
+    (void)pointers;
+#endif
+
+    char guest[512] = {};
+    if (g_snapshot)
+        g_snapshot(guest, sizeof guest);
+    else
+        std::snprintf(guest, sizeof guest, "(no guest state)");
+    out("guest: %s\n", guest);
+
+    if (!g_context.empty()) {
+        out("context:\n");
+        out("%s\n", g_context.c_str());
+    }
+    out("\nAddresses are relative to the module named beside them; the build's link map\n"
+        "(draconus_boot.map) or PDB names them. The lines above this block are the run's own\n"
+        "console output. Attach this file, with the launcher version, to a bug report.\n");
+    out("=== end of crash report: %s ===\n", g_path.c_str());
+    std::fflush(stderr);
+    g_writing = false;
+}
+
+#if defined(_WIN32)
+void guarded_crash(const char* what, void* pointers) {
+    __try {
+        write_crash(what, pointers);
+    } __except (EXCEPTION_EXECUTE_HANDLER) {
+        // The handler itself faulted; the process is already going down, and the log keeps
+        // whatever the run wrote before this point.
+    }
+}
+#else
+void guarded_crash(const char* what, void* pointers) {
+    write_crash(what, pointers);
+}
+#endif
+
+#if defined(_WIN32)
+LONG WINAPI on_unhandled_exception(EXCEPTION_POINTERS* pointers) {
+    guarded_crash("unhandled exception: the process would have been terminated", pointers);
+    // The report is in the file; suppress the WER dialog that would only offer the same nothing.
+    return EXCEPTION_EXECUTE_HANDLER;
+}
+#endif
+
+[[noreturn]] void on_terminate() {
+    static char message[320] = "terminate: an uncaught C++ exception reached the runtime";
+    if (const std::exception_ptr failure = std::current_exception()) {
+        try {
+            std::rethrow_exception(failure);
+        } catch (const std::exception& error) {
+            std::snprintf(message, sizeof message,
+                          "terminate: an uncaught C++ exception reached the runtime: %s",
+                          error.what() ? error.what() : "(no message)");
+        } catch (...) {
+            std::snprintf(message, sizeof message,
+                          "terminate: an uncaught non-standard exception reached the runtime");
+        }
+    }
+    guarded_crash(message, nullptr);
+    std::fflush(nullptr);
+    std::_Exit(3);
+}
+
+void on_abort(int) {
+    guarded_crash("abort: the C runtime aborted the process (a failed check or a failed assertion)",
+                  nullptr);
+    std::fflush(nullptr);
+    std::_Exit(3);
+}
+
+void at_exit_close() {
+    if (!g_file)
+        return;
+    out("\n[session ended at exit]\n");
+    std::fflush(nullptr);
+    std::fclose(g_file);
+    g_file = nullptr;
+}
+
+}  // namespace
+
+namespace dream::crashlog {
+
+bool enable(const std::filesystem::path& dir, const std::string& command_line,
+            std::string* error) {
+    if (g_file)
+        return true;  // one session per process
+    std::error_code ec;
+    std::filesystem::create_directories(dir, ec);
+    if (ec) {
+        if (error)
+            *error = "cannot create " + narrow(dir);
+        return false;
+    }
+    // One slot is this run's file, so nine of the previous ten survive the prune and the new one
+    // makes ten. Pruning first also means a failed open never has to delete anything.
+    prune(dir, 9);
+    const std::string stamp = local_stamp(true);
+    std::filesystem::path path = dir / ("draconus-" + stamp + ".log");
+    std::error_code exists_error;
+    for (unsigned n = 2; n < 100 && std::filesystem::exists(path, exists_error); ++n)
+        path = dir / ("draconus-" + stamp + "-" + std::to_string(n) + ".log");
+    std::FILE* file = open_log_file(path);
+    if (!file) {
+        if (error)
+            *error = "cannot create " + narrow(path);
+        return false;
+    }
+    std::setvbuf(file, nullptr, _IONBF, 0);
+    g_path = narrow(path);
+    g_started = std::time(nullptr);
+
+    // Both streams have to be unbuffered before the redirection, or a crash loses the lines still
+    // sitting in their buffers. setvbuf is legal here: nothing has been written to them yet.
+    std::setvbuf(stdout, nullptr, _IONBF, 0);
+    std::setvbuf(stderr, nullptr, _IONBF, 0);
+    std::printf("crash log: writing to %s\n", g_path.c_str());
+    std::fflush(stdout);
+    if (!redirect_into(file)) {
+        std::fclose(file);
+        g_path.clear();
+        if (error)
+            *error = "cannot redirect stdout/stderr into " + narrow(path);
+        return false;
+    }
+    g_file = file;
+
+    std::error_code cwd_error;
+    const std::string cwd = narrow(std::filesystem::current_path(cwd_error));
+    out("Draconus-Recomp session log\n");
+    out("started:  %s\n", local_stamp(false).c_str());
+    out("exe:      %s\n", exe_path().c_str());
+    out("cwd:      %s\n", cwd_error ? "(unknown)" : cwd.c_str());
+    out("host:     %s\n", os_description().c_str());
+    out("log:      %s\n", g_path.c_str());
+    if (!command_line.empty())
+        out("command:  %s\n", command_line.c_str());
+    out("\n");
+
+    std::set_terminate(on_terminate);
+    std::signal(SIGABRT, on_abort);
+#if defined(_WIN32)
+    collect_modules();
+    SetUnhandledExceptionFilter(on_unhandled_exception);
+#endif
+    std::atexit(at_exit_close);
+    return true;
+}
+
+void set_context(const std::string& text) {
+    g_context = text;
+}
+
+void refresh_modules() {
+#if defined(_WIN32)
+    g_module_count = 0;
+    collect_modules();
+#endif
+}
+
+void set_snapshot(Snapshot snapshot) {
+    g_snapshot = snapshot;
+}
+
+const std::string& session_path() {
+    return g_path;
+}
+
+void finish(int exit_code, bool faulted) {
+    if (!g_file)
+        return;
+    const double seconds = std::difftime(std::time(nullptr), g_started);
+    out("\nsession ended: %s (exit %d, %.1f s)\n",
+        faulted ? "the run did not finish cleanly" : "clean exit", exit_code, seconds);
+    std::fflush(nullptr);
+    std::fclose(g_file);
+    g_file = nullptr;
+}
+
+}  // namespace dream::crashlog
