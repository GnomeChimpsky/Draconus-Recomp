+#pragma once
+
+// Opt-in crash logging (`--crash-log`; the release launcher exposes it as a checkbox that is off by
+// default).
+//
+// One file per run is written under the per-user data directory:
+//
+//   %APPDATA%\dream-recomp\logs\draconus-YYYYMMDD-HHMMSS.log
+//
+// The file receives everything the run would have printed to stdout and stderr -- the boot lines,
+// warnings and the end-of-run report -- and, if the process dies without unwinding, a crash block
+// with the exception, the host stack as module-relative addresses and the guest state at that
+// moment. On Windows the block comes from an unhandled-exception filter, a terminate handler and
+// an abort handler; elsewhere from the terminate handler.
+//
+// Nothing happens unless enable() is called: no file is opened, no handler installed and the
+// console keeps its output. The report is best effort -- the handler uses plain writes and is
+// wrapped so that a fault inside it still lets the process die -- but it is what a bug report
+// needs, and a clean run's log is a record of the same session.
+
+#include <cstddef>
+#include <filesystem>
+#include <string>
+
+namespace dream::crashlog {
+
+// Guest numbers for the crash block, rendered by the host. Called from inside the crash handler, so
+// it must only read plain integers: no allocation, no locking and no I/O.
+using Snapshot = void (*)(char* out, std::size_t size);
+
+// Creates `dir`, starts a session file and redirects stdout/stderr into it. `command_line` is
+// recorded in the header. Returns false with `error` set when the directory or the file cannot be
+// made, and the caller then continues without logging. Prints one line naming the file to the
+// console before the redirection.
+bool enable(const std::filesystem::path& dir, const std::string& command_line, std::string* error);
+
+// Facts only known once the title is loaded: the game id, the config and the disc image.
+void set_context(const std::string& text);
+
+// Re-reads the loaded module list for the crash block. The window and the graphics driver load
+// after enable(), so the list taken there is out of date by the time the guest runs.
+void refresh_modules();
+
+// Guest state for the crash block, set once the System exists and cleared when the run ends.
+void set_snapshot(Snapshot snapshot);
+
+// The session file, empty while logging is off.
+const std::string& session_path();
+
+// Writes the closing line and closes the file. `faulted` marks a run that ended in a caught fault.
+// A no-op when logging is off or already finished.
+void finish(int exit_code, bool faulted);
+
+}  // namespace dream::crashlog
