+std::string trimmed(std::string text) {
+    const std::size_t first = text.find_first_not_of(" \t\r\n");
+    if (first == std::string::npos)
+        return {};
+    const std::size_t last = text.find_last_not_of(" \t\r\n");
+    return text.substr(first, last - first + 1);
+}
+
+// BUILD-INFO.txt beside the executable names the build whose map resolves the report. A source-tree
+// build has no such file, and says so rather than guessing.
+std::string build_info(const std::filesystem::path& exe) {
+    std::ifstream in(exe.parent_path() / "BUILD-INFO.txt", std::ios::binary);
+    if (!in)
+        return {};
+    std::string line, version, commit, built;
+    while (std::getline(in, line)) {
+        line = trimmed(line);
+        if (line.rfind("version:", 0) == 0)
+            version = trimmed(line.substr(8));
+        else if (line.rfind("commit:", 0) == 0)
+            commit = trimmed(line.substr(7));
+        else if (line.rfind("built:", 0) == 0)
+            built = trimmed(line.substr(6));
+    }
+    std::string text;
+    if (!version.empty())
+        text = "version " + version;
+    if (!commit.empty())
+        text += (text.empty() ? "" : ", ") + std::string("commit ") + commit;
+    if (!built.empty())
+        text += (text.empty() ? "" : ", ") + std::string("built ") + built;
+    return text;
+}
+
+// The executable's own hash, so a report and the symbols artifact for its build can be matched
+// exactly. One 37 MB read, and only while logging is on.
+std::string exe_sha1(const std::filesystem::path& path) {
+    std::ifstream in(path, std::ios::binary | std::ios::ate);
+    if (!in)
+        return {};
+    const std::streamoff size = in.tellg();
+    if (size <= 0 || size > (256LL << 20))
+        return {};
+    in.seekg(0);
+    std::vector<char> bytes;
+    try {
+        bytes.resize(static_cast<std::size_t>(size));
+    } catch (...) {
+        return {};  // no hash is better than failing to start when logging was asked for
+    }
+    if (!in.read(bytes.data(), static_cast<std::streamsize>(size)))
+        return {};
+    return dream::hash::sha1_hex(bytes.data(), bytes.size());
+}
